generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ─── UTILISATEURS DU SYSTÈME (Admin & Associés) ──────────────────────────────
model User {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String
  name        String
  role        String   @default("ASSOCIÉ") // ADMINISTRATEUR, ASSOCIÉ
  profile     String? // Profil de permissions (ex: Juriste, Comptable)
  permissions String? // Droits JSON (ex: ["MANAGE_CLIENTS", "VIEW_ALL", "EDIT_USERS"])
  idCardUrl   String?
  isBlocked   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignedTasks    Task[]     @relation("AssignedTasks")
  createdTasks     Task[]     @relation("CreatedTasks")
  assignedFormulaires Formulaire[]  @relation("AssignedFormulaires")
  createdDossiers  Dossier[]
  documents        Document[]
  comments         Comment[]
  auditLogs        AuditLog[]
}

// ─── CLIENTS (Personnes externes au CRM) ──────────────────────────────────────
model Client {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  company   String?
  phone     String?
  idCardUrl String?
  status    String   @default("ACTIF") // ACTIF, SUSPENDU
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dossiers Dossier[]
  formulaires Formulaire[]
}

// ─── FORMULAIRES (Entrées du site web) ─────────────────────────────────
model Formulaire {
  id              String  @id @default(uuid())
  formulaireId    String  @unique // Garantie d'unicité (Message-ID de l'email)
  type            String  @default("CONTACT") // CONTACT, RECRUTEMENT
  statusSubmitter String? // SOCIETE, PARTICULIER
  nomPrenom       String
  email           String
  telephone       String?
  description     String?
  raisonSocial    String?
  objet           String?

  bodyHtml        String? // Copie de l'email original envoyé

  // NOUVEAU, ATTRIBUE, INITIE, CONTROLE, A_CORRIGER, REATTRIBUE, TERMINE, ARCHIVE
  status String @default("NOUVEAU")
  isAnonyme Boolean @default(true)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  dossierId String?
  dossier   Dossier? @relation(fields: [dossierId], references: [id], onDelete: SetNull)

  assignedToId String?
  assignedTo   User?   @relation("AssignedFormulaires", fields: [assignedToId], references: [id], onDelete: SetNull)

  recrutement FormulaireRecrutement?
  contact     FormulaireContact?

  receivedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  auditLogs AuditLog[]
}

model FormulaireRecrutement {
  id              String @id @default(uuid())
  formulaireId    String @unique
  formulaire      Formulaire @relation(fields: [formulaireId], references: [id], onDelete: Cascade)
  
  competenceCle   String?
  anneeExperience String?
  lieuResidence   String?
  langue          String?
  lienLinkedin    String?
}

model FormulaireContact {
  id              String @id @default(uuid())
  formulaireId    String @unique
  formulaire      Formulaire @relation(fields: [formulaireId], references: [id], onDelete: Cascade)

  typeBesoin      String?
  pieceJointe     String? // URL ou ID du fichier
}

// ─── DOSSIERS (Catégorisation des requêtes clients) ───────────────────────────
model Dossier {
  origin String @default("INTERNE")
  createdById String?
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  id          String  @id @default(uuid())
  name        String // Créé et nommé par l'administrateur
  description String?

  // NOUVEAU, ATTRIBUE, INITIE, CONTROLE, A_CORRIGER, REATTRIBUE, TERMINE, ARCHIVE
  status   String @default("NOUVEAU")
  priority String @default("NORMAL")

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  formulaires  Formulaire[]
  tasks     Task[]
  documents Document[]
  comments  Comment[]
  auditLogs AuditLog[]
  messagePersonnels MessagePersonnel[]
}

// ─── CHAT INTERNE (Commentaires entre Associés sur un Dossier) ────────────────
model Comment {
  id      String  @id @default(uuid())
  content String
  isFile  Boolean @default(false)
  fileUrl String?

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  dossierId String?
  dossier   Dossier? @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// ─── GESTION DES TÂCHES (Optionnel pour le workflow métier) ───────────────────
model Task {
  id           String  @id @default(uuid())
  dossierId    String
  dossier      Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  assignedToId String?
  assignedTo   User?   @relation("AssignedTasks", fields: [assignedToId], references: [id])
  createdById  String
  createdBy    User    @relation("CreatedTasks", fields: [createdById], references: [id])

  description String
  deadline    DateTime?
  status      String    @default("TO_ASSIGN")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents Document[]
  comments  Comment[]
}

// ─── DOCUMENTS GLOBAUX ────────────────────────────────────────────────────────
model Document {
  id           String @id @default(uuid())
  name         String
  url          String
  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  dossierId String?
  dossier   Dossier? @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// ─── AUDIT TRAIL (L'Oeil de l'Admin : qui fait quoi) ──────────────────────────
model AuditLog {
  id     String  @id @default(uuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action String // CREATION_DOSSIER, CHANGEMENT_STATUT, TELECHARGEMENT_DOC

  targetId   String?
  targetType String?
  details    String?

  dossierId String?
  dossier   Dossier? @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  formulaireId String?
  formulaire   Formulaire? @relation(fields: [formulaireId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// ─── MESSAGES (Interne & Personnel) ──────────────────────────────────────────
model MessagePersonnel {
  id          String   @id @default(uuid())
  messageId   String   @unique
  type        String   @default("PERSONNEL") // INTERNE, PERSONNEL
  status      String   @default("NOUVEAU")
  nomPrenom   String
  email       String
  objet       String?
  bodyText    String?
  attachment  String?
  createdAt   DateTime @default(now())
  receivedAt  DateTime @default(now())

  dossierId   String?
  dossier     Dossier? @relation(fields: [dossierId], references: [id], onDelete: SetNull)
}
