generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ─── ROLES & PERMISSIONS ─────────────────────────────────────────────────────
model Role {
  id          String   @id @default(uuid())
  name        String   @unique // ex: ADMINISTRATEUR, ASSOCIÉ, JURISTE
  description String?
  status      String   @default("Actif")
  permissions String? // JSON des droits
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  utilisateurs Utilisateur[]
}

// ─── UTILISATEURS DU SYSTÈME (Admin & Associés) ──────────────────────────────
model Utilisateur {
  id       String @id @default(uuid())
  email    String @unique
  password String
  name     String

  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id], onDelete: SetNull)

  telephone        String?
  lieuResidence    String?
  experienceCle    String?
  langues          String?
  profile          String?
  idCardUrl        String?
  resetToken       String?
  resetTokenExpiry DateTime?
  isBlocked        Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  assignedMissions          Mission[]          @relation("AssignedMissions")
  createdMissions           Mission[]          @relation("CreatedMissions")
  dossiersTraites           Dossier[]          @relation("DossierTraitant")
  assignedTaches            Tache[]            @relation("AssignedTaches")
  createdTaches             Tache[]            @relation("CreatedTaches")
  assignedFormulaires       Formulaire[]       @relation("AssignedFormulaires")
  createdDossiers           Dossier[]
  targetDossiers            Dossier[]          @relation("DossierTarget")
  documents                 Document[]
  auditLogs                 AuditLog[]
  assignedMessagePersonnels MessagePersonnel[] @relation("AssignedMessagePersonnels")
  publications              Publication[]
}

// ─── CLIENTS (Personnes externes au CRM) ──────────────────────────────────────
model Client {
  id                String   @id @default(uuid())
  type              String   @default("PARTICULIER") // SOCIETE, PARTICULIER
  email             String   @unique
  name              String
  telephone         String?
  contactSecondaire String?
  secteurActivite   String?
  description       String?
  status            String   @default("ACTIF")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  entreprise ClientEntreprise?

  dossiers    Dossier[]
  formulaires Formulaire[]
}

model ClientEntreprise {
  id       String @id @default(uuid())
  clientId String @unique
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  siret               String?
  raisonSociale       String?
  emailEntreprise     String?
  telephoneEntreprise String?
}

// ─── FORMULAIRES (Entrées du site web) ─────────────────────────────────
model Formulaire {
  id              String  @id @default(uuid())
  formulaireId    String  @unique
  type            String  @default("CONTACT")
  statusSubmitter String?
  nomPrenom       String
  email           String
  telephone       String?
  priority        String  @default("NORMAL")
  description     String?
  raisonSocial    String?
  objet           String?
  bodyHtml        String?
  status          String  @default("NOUVEAU")
  isAnonyme       Boolean @default(true)
  verifaliaJobId      String?
  verifaliaStatus     String?
  verifaliaNextRetry  DateTime?
  verifaliaRetries    Int      @default(0)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  dossierId String?
  dossier   Dossier? @relation(fields: [dossierId], references: [id], onDelete: SetNull)

  missionId String?
  mission   Mission? @relation(fields: [missionId], references: [id], onDelete: SetNull)

  tacheId String?
  tache   Tache?  @relation(fields: [tacheId], references: [id], onDelete: SetNull)

  assignedToId String?
  assignedTo   Utilisateur? @relation("AssignedFormulaires", fields: [assignedToId], references: [id], onDelete: SetNull)

  recrutement FormulaireRecrutement?
  contact     FormulaireContact?

  receivedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  auditLogs AuditLog[]
}

model FormulaireRecrutement {
  id              String     @id @default(uuid())
  formulaireId    String     @unique
  formulaire      Formulaire @relation(fields: [formulaireId], references: [id], onDelete: Cascade)
  competenceCle   String?
  anneeExperience String?
  lieuResidence   String?
  langue          String?
  lienLinkedin    String?
}

model FormulaireContact {
  id           String     @id @default(uuid())
  formulaireId String     @unique
  formulaire   Formulaire @relation(fields: [formulaireId], references: [id], onDelete: Cascade)
  typeBesoin   String?
  pieceJointe  String?
}

// ─── DOSSIERS (Catégorisation des requêtes clients) ───────────────────────────
model Dossier {
  origin         String       @default("INTERNE")
  createdById    String?
  createdBy      Utilisateur? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  id             String       @id @default(uuid())
  reference      String?      @unique
  name           String
  description    String?
  status         String       @default("NOUVEAU")
  previousStatus String?
  priority       String       @default("NORMAL")
  categorie      String?

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  targetUserId String?
  targetUser   Utilisateur? @relation("DossierTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  traitantId String?
  traitant   Utilisateur? @relation("DossierTraitant", fields: [traitantId], references: [id], onDelete: SetNull)

  parentDossierId String?
  parentDossier   Dossier?  @relation("SubDossiers", fields: [parentDossierId], references: [id])
  subDossiers     Dossier[] @relation("SubDossiers")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  formulaires       Formulaire[]
  missions          Mission[]
  documents         Document[]
  auditLogs         AuditLog[]
  messagePersonnels MessagePersonnel[]

  missionsLinked        Mission[] @relation("MissionDossierLinked")
  authorizedForMissions Mission[] @relation("MissionAuthorizedDossiers")

  tachesLinked        Tache[] @relation("TacheDossierLinked")
  authorizedForTaches Tache[] @relation("TacheAuthorizedDossiers")
  
  liensMagiques       LienMagique[]
}

// ─── MISSIONS (Anciennement Tasks) ────────────────────────────────────────────
model Mission {
  id        String  @id @default(uuid())
  reference String? @unique
  dossierId String
  dossier   Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  assignedToId String?
  assignedTo   Utilisateur? @relation("AssignedMissions", fields: [assignedToId], references: [id])

  createdById String
  createdBy   Utilisateur @relation("CreatedMissions", fields: [createdById], references: [id])

  description    String
  echeance       DateTime?
  status         String    @default("TO_ASSIGN")
  previousStatus String?
  attachment     String?

  dossierMissionId String?
  dossierMission   Dossier? @relation("MissionDossierLinked", fields: [dossierMissionId], references: [id], onDelete: SetNull)

  authorizedDossiers Dossier[] @relation("MissionAuthorizedDossiers")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parentMissionId String?
  parentMission   Mission?  @relation("SubMissions", fields: [parentMissionId], references: [id])
  subMissions     Mission[] @relation("SubMissions")

  documents         Document[]
  messagePersonnels MessagePersonnel[]
  formulaires       Formulaire[]
  taches            Tache[]
}

// ─── TACHES (Liées aux Missions) ─────────────────────────────────────────────
model Tache {
  id        String  @id @default(uuid())
  reference String? @unique
  missionId String
  mission   Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  assignedToId String?
  assignedTo   Utilisateur? @relation("AssignedTaches", fields: [assignedToId], references: [id])

  createdById String
  createdBy   Utilisateur @relation("CreatedTaches", fields: [createdById], references: [id])

  description     String
  echeance        DateTime?
  status          String    @default("TO_ASSIGN")
  previousStatus  String?
  attachment      String?
  adminFeedback   String?
  managerFeedback String?

  dossierTacheId String?
  dossierTache   Dossier? @relation("TacheDossierLinked", fields: [dossierTacheId], references: [id], onDelete: SetNull)

  authorizedDossiers Dossier[] @relation("TacheAuthorizedDossiers")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messagePersonnels MessagePersonnel[]
  formulaires       Formulaire[]
}

// ─── DOCUMENTS GLOBAUX ────────────────────────────────────────────────────────
model Document {
  id           String      @id @default(uuid())
  name         String
  url          String
  uploadedById String
  uploadedBy   Utilisateur @relation(fields: [uploadedById], references: [id])

  dossierId String?
  dossier   Dossier? @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  missionId String?
  mission   Mission? @relation(fields: [missionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  isDeleted Boolean  @default(false)
}

// ─── AUDIT TRAIL ──────────────────────────────────────────────────────────────
model AuditLog {
  id     String       @id @default(uuid())
  userId String?
  user   Utilisateur? @relation(fields: [userId], references: [id], onDelete: SetNull)

  action     String
  targetId   String?
  targetType String?
  details    String?

  dossierId String?
  dossier   Dossier? @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  formulaireId String?
  formulaire   Formulaire? @relation(fields: [formulaireId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// ─── MESSAGES (Interne & Personnel) ──────────────────────────────────────────
model MessagePersonnel {
  id         String   @id @default(uuid())
  messageId  String   @unique
  type       String   @default("PERSONNEL")
  subType    String   @default("Indéfini")
  status     String   @default("NOUVEAU")
  nomPrenom  String
  email      String
  objet      String?
  bodyText   String?
  attachment String?
  
  etiquette  String?
  priorite   String   @default("Normal")
  isDeleted  Boolean  @default(false)

  createdAt  DateTime @default(now())
  receivedAt DateTime @default(now())

  dossierId String?
  dossier   Dossier? @relation(fields: [dossierId], references: [id], onDelete: SetNull)

  missionId String?
  mission   Mission? @relation(fields: [missionId], references: [id], onDelete: SetNull)

  assignedToId String?
  assignedTo   Utilisateur? @relation("AssignedMessagePersonnels", fields: [assignedToId], references: [id], onDelete: SetNull)
  Tache        Tache?       @relation(fields: [tacheId], references: [id])
  tacheId      String?
}

// ─── CMS (Publications, Offres d'emploi, Articles) ───────────────────────────
model Publication {
  id          String   @id @default(uuid())
  title       String
  type        String   @default("ACTUALITE") // ACTUALITE, OFFRE_EMPLOI
  category    String?  // Ex: "Blog", "Événement", "CDI", "Stage"
  excerpt     String?  // Résumé court
  location    String?  // Localisation pour les offres
  contentHtml String?
  coverImage  String?  // URL S3 de l'image
  status      String   @default("BROUILLON") // BROUILLON, PUBLIE
  authorId    String
  author      Utilisateur @relation(fields: [authorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  publishedAt DateTime?
}

// ─── LIENS MAGIQUES (Acquisition & Livraison) ────────────────────────────────
model LienMagique {
  id          String   @id @default(uuid())
  token       String   @unique @default(uuid())
  type        String   // "ACQUISITION" (Client upload) ou "LIVRAISON" (Client download)
  dossierId   String
  dossier     Dossier  @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  createdBy   String   // id de l'utilisateur qui a généré le lien
  expiresAt   DateTime
  isUsed      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

