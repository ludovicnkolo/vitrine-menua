      <button
        type="button"
        disabled={page >= totalPages}
        onClick={() => setPage((p) => Math.min(totalPages, p + 1))}
        style={{
          padding: "0.5rem 1rem",
          borderRadius: "4px",
          border: "1px solid var(--border)",
