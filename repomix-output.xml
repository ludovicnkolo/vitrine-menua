<file path="apps/admin/src/components/SmsModal.jsx">
import { getSafeApiUrl } from "../utils/helpers";
import React, { useState, useEffect } from "react";
import { X, Send } from "lucide-react";

const SmsModal = ({ isOpen, onClose, contextData }) => {
  const [users, setUsers] = useState([]);
  const [loading, setLoading] = useState(false);
  const [subject, setSubject] = useState("");
  const [content, setContent] = useState("");
  const [targetUserId, setTargetUserId] = useState("");
  const [file, setFile] = useState(null);
  const [currentUser, setCurrentUser] = useState(null);

  useEffect(() => {
    try {
      const userStr = sessionStorage.getItem("adminUser");
      if (userStr) setCurrentUser(JSON.parse(userStr));
    } catch (e) {}
  }, []);

  useEffect(() => {
    if (isOpen) {
      const fetchUsers = async () => {
        try {
          const token = sessionStorage.getItem("adminToken");

          const res = await fetch(getSafeApiUrl(`/api/crm/users`), {
            headers: { Authorization: `Bearer ${token}` },
          });
          if (res.ok) {
            setUsers(await res.json());
          }
        } catch (err) {
          console.error(err);
        }
      };
      fetchUsers();
    }
  }, [isOpen]);

  useEffect(() => {
    if (isOpen && contextData && currentUser) {
      if (contextData.assignedToId && contextData.createdById) {
        if (currentUser.id === contextData.assignedToId)
          setTargetUserId(contextData.createdById);
        else setTargetUserId(contextData.assignedToId);
      }
      if (contextData.reference) {
        setSubject(`Message concernant ${contextData.reference}`);
      }
    }
  }, [isOpen, contextData, currentUser]);

  const isAutoAssigned = !!(
    contextData?.assignedToId && contextData?.createdById
  );
  const isAutoSubject = !!contextData?.reference;

  const handleSubmit = async (e) => {
    e.preventDefault();
    if (!targetUserId || !content || !subject) {
      window.customAlert(
        "Veuillez remplir l'objet, le contenu et le destinataire.",
      );
      return;
    }

    try {
      setLoading(true);
      const token = sessionStorage.getItem("adminToken");

      let attachmentStr = null;
      if (file) {
        const formData = new FormData();
        formData.append("bucket", "formulaires");
        formData.append("file", file);
        const uploadRes = await fetch(getSafeApiUrl(`/api/files/upload`), {
          method: "POST",
          headers: { Authorization: `Bearer ${token}` },
          body: formData,
        });
        const uploadData = await uploadRes.json();
        if (uploadData.success) {
          attachmentStr = uploadData.fileData.filename;
        }
      }

      // Find selected user name
      const targetUser = users.find((u) => u.id === targetUserId);
      const recipientName = targetUser ? targetUser.name : "Inconnu";

      // Send to messages endpoint
      const payload = {
        type: "INTERNE",
        subType: `SMS Collaborateur pour ${recipientName}`,
        objet: subject,
        bodyText: content,
        attachment: attachmentStr,
        dossierId: contextData?.dossierId || null,
        missionId: contextData?.missionId || null,
        tacheId: contextData?.tacheId || null,
        assignedToId: targetUserId,
      };

      const res = await fetch(getSafeApiUrl(`/api/crm/messages/interne`), {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Authorization: `Bearer ${token}`,
        },
        body: JSON.stringify(payload),
      });

      if (res.ok) {
        window.customAlert("SMS envoyé avec succès !");
        onClose();
        setSubject("");
        setContent("");
        setTargetUserId("");
        setFile(null);
      } else {
        const errData = await res.json().catch(() => ({}));
        window.customAlert(
          `Erreur lors de l'envoi du SMS: ${errData.details || errData.error || res.statusText}`,
        );
      }
    } catch (err) {
      console.error(err);
      window.customAlert("Erreur réseau.");
    } finally {
      setLoading(false);
    }
  };

  if (!isOpen) return null;

  return (
    <div
      style={{
        position: "fixed",
        top: 0,
        left: 0,
        right: 0,
        bottom: 0,
        background: "rgba(0,0,0,0.5)",
        zIndex: 1000,
        display: "flex",
        alignItems: "center",
        justifyContent: "center",
      }}
    >
      <div
        className="fade-in"
        style={{
          background: "#FFF",
          width: "90%",
          maxWidth: "600px",
          borderRadius: "12px",
          padding: "2rem",
          boxShadow: "0 10px 25px rgba(0,0,0,0.2)",
        }}
      >
        <div
          style={{
            display: "flex",
            justifyContent: "space-between",
            alignItems: "center",
            marginBottom: "1.5rem",
            borderBottom: "1px solid var(--border)",
            paddingBottom: "1rem",
          }}
        >
          <h2 style={{ margin: 0, fontSize: "1.25rem", fontWeight: 600 }}>
            Envoyer un SMS Collaborateur
          </h2>
          <button
            type="button"
            onClick={onClose}
            style={{
              background: "transparent",
              border: "none",
              cursor: "pointer",
              color: "var(--text-muted)",
            }}
          >
            <X size={24} />
          </button>
        </div>

        <form
          onSubmit={handleSubmit}
          style={{ display: "flex", flexDirection: "column", gap: "1rem" }}
        >
          {!isAutoAssigned && (
            <div>
              <label
                htmlFor="smsDestinataire"
                style={{
                  display: "block",
                  marginBottom: "0.5rem",
                  fontWeight: 500,
                  
                }}
              >
                Destinataire (Collaborateur)
              </label>
              <select
                id="smsDestinataire"
                value={targetUserId}
                onChange={(e) => setTargetUserId(e.target.value)}
                required
                className="input-field"
                style={{
                  width: "100%",
                  padding: "0.75rem",
                  borderRadius: "8px",
                  border: "1px solid var(--border)",
                  background: "#FFF",
                }}
              >
                <option value="">-- Sélectionner un collaborateur --</option>
                {users.map((u) => (
                  <option key={u.id} value={u.id}>
                    {u.name} ({u.role?.name || "Sans rôle"})
                  </option>
                ))}
              </select>
            </div>
          )}

          {!isAutoSubject && (
            <div>
              <label
                htmlFor="smsSubject"
                style={{
                  display: "block",
                  marginBottom: "0.5rem",
                  fontWeight: 500,
                  
                }}
              >
                Objet
              </label>
              <input
                id="smsSubject"
                type="text"
                value={subject}
                onChange={(e) => setSubject(e.target.value)}
                required
                placeholder="Sujet du SMS"
                className="input-field"
                style={{
                  width: "100%",
                  padding: "0.75rem",
                  borderRadius: "8px",
                  border: "1px solid var(--border)",
                  background: "#FFF",
                }}
              />
            </div>
          )}

          <div>
            <label
              htmlFor="smsContent"
              style={{
                display: "block",
                marginBottom: "0.5rem",
                fontWeight: 500,
                
              }}
            >
              Contenu du message
            </label>
            <textarea
              id="smsContent"
              value={content}
              onChange={(e) => setContent(e.target.value)}
              required
              placeholder="Tapez votre message ici..."
              className="input-field"
              rows={5}
              style={{
                width: "100%",
                padding: "0.75rem",
                borderRadius: "8px",
                border: "1px solid var(--border)",
                background: "#FFF",
                resize: "vertical",
              }}
            />
          </div>

          <div>
            <label
              htmlFor="smsFile"
              style={{
                display: "block",
                marginBottom: "0.5rem",
                fontWeight: 500,
                
              }}
            >
              Fichier joint (Optionnel)
            </label>
            <input
              id="smsFile"
              type="file"
              onChange={(e) => setFile(e.target.files[0])}
              className="input-field"
              style={{
                width: "100%",
                padding: "0.5rem",
                borderRadius: "8px",
                border: "1px solid var(--border)",
                background: "#FFF",
              }}
            />
          </div>

          <div
            style={{
              display: "flex",
              justifyContent: "flex-end",
              gap: "1rem",
              marginTop: "1rem",
            }}
          >
            <button
              type="button"
              onClick={onClose}
              className="btn btn-outline"
              style={{ padding: "0.75rem 1.5rem" }}
            >
              Annuler
            </button>
            <button
              type="submit"
              disabled={loading}
              className="btn btn-primary"
              style={{
                padding: "0.75rem 1.5rem",
                display: "flex",
                alignItems: "center",
                gap: "0.5rem",
              }}
            >
              <Send size={16} />
              {loading ? "Envoi..." : "Envoyer SMS"}
            </button>
          </div>
        </form>
      </div>
    </div>
  );
};

export default SmsModal;
</file>

<file path="apps/admin/src/components/SpacePageLayout.jsx">
import React, { useState, useEffect } from "react";
import { useLocation } from "react-router-dom";
import TabsNavigation from "./TabsNavigation";

const SpacePageLayout = ({ initialTab, tabs, children }) => {
  const location = useLocation();
  const storageKey = `active_tab_${location.pathname}`;

  const [tab, setTab] = useState(() => {
    if (location.state && location.state.tab) return location.state.tab;
    const saved = sessionStorage.getItem(storageKey);
    if (saved && tabs.some((t) => t.id === saved)) return saved;
    return initialTab;
  });

  useEffect(() => {
    if (location.state && location.state.tab) {
      setTab(location.state.tab);
      sessionStorage.setItem(storageKey, location.state.tab);
    }
  }, [location, storageKey]);

  const handleTabChange = (newTab) => {
    setTab(newTab);
    sessionStorage.setItem(storageKey, newTab);
  };

  return (
    <div style={{ padding: "0 1rem" }}>
      <TabsNavigation tabs={tabs} activeTab={tab} onTabChange={handleTabChange} />
      <div>{children(tab)}</div>
    </div>
  );
};

export default SpacePageLayout;
</file>

