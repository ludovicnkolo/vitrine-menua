"use client";
import NextLink, { LinkProps as NextLinkProps } from "next/link";
import { useLanguage } from "./LanguageProvider";
import { usePathname } from "next/navigation";
import React from "react";

interface LinkProps extends Omit<React.AnchorHTMLAttributes<HTMLAnchorElement>, keyof NextLinkProps>, NextLinkProps {
  href: string;
  children?: React.ReactNode;
}

export const enRouteMap: Record<string, string> = {
  "/nous-connaitre": "/about-us",
  "/vos-besoins": "/your-needs",
  "/nos-solutions": "/our-solutions",
  "/pourquoi-menua": "/why-choose-us",
  "/actualites": "/news",
  "/nous-rejoindre": "/join-us",
  "/nous-contacter": "/contact-us",
  "/mentions-legales": "/legal-notices",
  "/politique-de-confidentialite": "/privacy-policy"
};

export const frRouteMap: Record<string, string> = Object.entries(enRouteMap).reduce((acc, [fr, en]) => {
  acc[en] = fr;
  return acc;
}, {} as Record<string, string>);

export default function Link({ href, children, ...props }: LinkProps) {
  const { lang } = useLanguage();
  const currentPathname = usePathname();
  const isFrPrefix = currentPathname?.startsWith("/fr");
  
  let finalHref = href;
  if (typeof href === "string" && href.startsWith("/") && !href.startsWith("/en/") && !href.startsWith("/fr/") && href !== "/en" && href !== "/fr") {
    
    let pathToTranslate = href;
    let suffix = "";
    const hashIndex = href.indexOf('#');
    const queryIndex = href.indexOf('?');
    const splitIndex = Math.min(
      hashIndex !== -1 ? hashIndex : href.length,
      queryIndex !== -1 ? queryIndex : href.length
    );

    if (splitIndex !== href.length) {
      pathToTranslate = href.substring(0, splitIndex);
      suffix = href.substring(splitIndex);
    }

    if (lang === "EN") {
      // 1. Exact match in map
      if (enRouteMap[pathToTranslate]) {
        pathToTranslate = enRouteMap[pathToTranslate];
      } else {
        // 2. Dynamic sub-path: find if path STARTS WITH a known FR route
        // e.g. /actualites/article-id → /news/article-id
        const matchedFrBase = Object.keys(enRouteMap).find(
          (frBase) => frBase !== '/' && pathToTranslate.startsWith(frBase + '/')
        );
        if (matchedFrBase) {
          const enBase = enRouteMap[matchedFrBase];
          pathToTranslate = enBase + pathToTranslate.slice(matchedFrBase.length);
        }
      }
      const translatedHref = pathToTranslate + suffix;
      finalHref = translatedHref === "/" ? "/en" : `/en${translatedHref}`;
    } else {
      finalHref = pathToTranslate === "/" ? "/fr" : `/fr${pathToTranslate}${suffix}`;
    }
  }

  return (
    <NextLink href={finalHref} {...props}>
      {children}
    </NextLink>
  );
}
</file>

<file path="apps/admin/src/components/FilePreviewModal.jsx">
import React, { useEffect, useState } from "react";
import { Eye, ChevronLeft, ChevronRight, ZoomIn, ZoomOut } from "lucide-react";
import { getSafeApiUrl } from "../utils/helpers";
import { pdfjs, Document, Page } from "react-pdf";
import "react-pdf/dist/Page/AnnotationLayer.css";
import "react-pdf/dist/Page/TextLayer.css";

pdfjs.GlobalWorkerOptions.workerSrc = `//unpkg.com/pdfjs-dist@${pdfjs.version}/build/pdf.worker.min.mjs`;

const FilePreviewModal = ({ previewFile, onClose }) => {
  const [previewBlobUrl, setPreviewBlobUrl] = useState(null);
  const [error, setError] = useState(null);
  const [isLoading, setIsLoading] = useState(false);
  const [numPages, setNumPages] = useState(null);
  const [pageNumber, setPageNumber] = useState(1);
  const [scale, setScale] = useState(1.0);

  useEffect(() => {
    if (!previewFile) {
      setPreviewBlobUrl(null);
      setError(null);
      setIsLoading(false);
      setNumPages(null);
      setPageNumber(1);
      setScale(1.0);
      return;
    }
    setError(null);
    setIsLoading(true);

    try {
      const token = sessionStorage.getItem("adminToken");
      const parts = previewFile.split("/");
      let bucket = "formulaires";
      let filename = previewFile;
      if (parts.length > 1) {
        bucket = parts.shift();
        filename = parts.join("/");
      }
      // Utilise le proxy backend avec stream=true pour contourner le blocage CORS de S3 OVH
      // (S3 OVH ne retourne pas Access-Control-Allow-Origin sur les URLs présignées)
      // On encode chaque segment du filename séparément pour préserver les "/" (clés S3 multi-niveaux)
      const encodedFilename = filename.split("/").map(encodeURIComponent).join("/");
      const urlObj = new URL(
        getSafeApiUrl(
          `/api/files/view/${encodeURIComponent(bucket)}/${encodedFilename}`,
        ),
      );
      if (token) urlObj.searchParams.set("token", token);
      urlObj.searchParams.set("stream", "true");
      urlObj.searchParams.set("t", Date.now()); // Cache buster pour contourner le cache du navigateur

      setPreviewBlobUrl(urlObj.toString());
    } catch (err) {
      console.error("Error setting preview URL:", err);
      setError(err.message || "Invalid URL");
    }
  }, [previewFile]);

  if (!previewFile) return null;

  const isImage = previewFile.match(/\.(jpeg|jpg|png|gif|webp|svg)$/i);
  const isPdf = previewFile.match(/\.pdf$/i);
  const isUnsupported = !isImage && !isPdf;

  return (
    <div
      style={{
        position: "fixed",
        top: 0,
        left: 0,
        right: 0,
        bottom: 0,
        background: "rgba(0,0,0,0.8)",
        display: "flex",
        flexDirection: "column",
        alignItems: "center",
        justifyContent: "center",
        zIndex: 200,
      }}
    >
      <div
        style={{
          width: "80%",
          height: "80%",
          background: "#FFF",
          borderRadius: "8px",
          display: "flex",
          flexDirection: "column",
          overflow: "hidden",
        }}
      >
        {/* En-tête */}
        <div
          style={{
            padding: "1rem",
            borderBottom: "1px solid var(--border)",
            display: "flex",
            justifyContent: "space-between",
            alignItems: "center",
            background: "#F8FAFC",
          }}
        >
          <h3
            style={{
              margin: 0,
              fontSize: "1rem",
              display: "flex",
              alignItems: "center",
              gap: "0.5rem",
            }}
          ></h3>

          {/* Barre de contrôle pour le PDF */}
          {!isImage && !error && previewBlobUrl && (
            <div style={{ display: "flex", alignItems: "center", gap: "1rem" }}>
              <div
                style={{
                  display: "flex",
                  alignItems: "center",
                  gap: "0.5rem",
                  background: "#FFF",
                  padding: "0.25rem",
                  borderRadius: "6px",
                  border: "1px solid var(--border)",
                }}
              >
                <button
                  onClick={() => setScale((s) => Math.max(0.5, s - 0.2))}
                  style={{
                    background: "none",
                    border: "none",
                    cursor: "pointer",
                    display: "flex",
                    alignItems: "center",
                  }}
                >
                  <ZoomOut size={16} />
                </button>
                <span
                  style={{
                    
                    minWidth: "40px",
                    textAlign: "center",
                  }}
                >
                  {Math.round(scale * 100)}%
                </span>
                <button
                  onClick={() => setScale((s) => s + 0.2)}
                  style={{
                    background: "none",
                    border: "none",
                    cursor: "pointer",
                    display: "flex",
                    alignItems: "center",
                  }}
                >
                  <ZoomIn size={16} />
                </button>
              </div>
            </div>
          )}

          <button
            type="button"
            onClick={onClose}
            className="btn btn-outline"
            style={{ padding: "0.25rem 0.5rem", height: "auto" }}
          >
            Fermer
          </button>
        </div>

        {/* Zone d'affichage */}
        <div
          style={{
            flex: 1,
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            background: "#E2E8F0",
            padding: "2rem",
            overflow: "hidden",
          }}
        >
          <div
            style={{
              width: "100%",
              height: "100%",
              background: "#FFF",
              boxShadow: "0 4px 6px rgba(0,0,0,0.1)",
              borderRadius: "8px",
              overflow: "auto",
              display: "flex",
              justifyContent: "center",
            }}
          >
            {(() => {
              if (error) {
                return (
                  <div
                    style={{
                      display: "flex",
                      flexDirection: "column",
                      alignItems: "center",
                      justifyContent: "center",
                      height: "100%",
                      gap: "1rem",
                      padding: "2rem",
                      textAlign: "center",
                    }}
                  >
                    <div style={{ color: "var(--danger)", fontWeight: 500 }}>
                      Ce fichier est introuvable ou inaccessible.<br />
                      Détails de l'erreur: {String(error)}
                    </div>
                    <a
                      href={previewBlobUrl}
                      target="_blank"
                      rel="noreferrer"
                      className="btn btn-outline"
                      style={{ textDecoration: "none" }}
                    >
                      Ouvrir dans un nouvel onglet
                    </a>
                  </div>
                );
              }
              if (!previewBlobUrl || (isLoading && isImage)) {
                return (
                  <div
                    style={{
                      display: "flex",
                      flexDirection: "column",
                      alignItems: "center",
                      justifyContent: "center",
                      height: "100%",
                      gap: "1rem",
                      color: "var(--text-muted)",
                    }}
                  >
                    <div style={{
                      width: "40px",
                      height: "40px",
                      border: "3px solid var(--border)",
                      borderTopColor: "var(--primary)",
                      borderRadius: "50%",
                      animation: "spin 0.8s linear infinite",
                    }} />
                    <span>Chargement du fichier...</span>
                  </div>
                );
              }
              if (isImage) {
                return (
                  <div style={{ width: "100%", height: "100%", display: "flex", alignItems: "center", justifyContent: "center", position: "relative" }}>
                    <img
                      src={previewBlobUrl}
                      alt={previewFile.split("/").pop()}
                      style={{
                        maxWidth: "100%",
                        maxHeight: "100%",
                        objectFit: "contain",
                      }}
                      onLoad={() => setIsLoading(false)}
                      onError={() => {
                        setIsLoading(false);
                        setError("Impossible de charger l'image.");
                      }}
                    />
                  </div>
                );
              }
              if (isUnsupported) {
                return (
                  <div
                    style={{
                      display: "flex",
                      flexDirection: "column",
                      alignItems: "center",
                      justifyContent: "center",
                      height: "100%",
                      gap: "1rem",
                      padding: "2rem",
                      textAlign: "center",
                    }}
                  >
                    <div
                      style={{ fontSize: "3rem", color: "var(--text-muted)" }}
                    >
                      📄
                    </div>
                    <div style={{ color: "var(--text-main)", fontWeight: 500 }}>
                      Ce type de fichier ne peut pas être prévisualisé
                      directement.
                    </div>
                    <a
                      href={previewBlobUrl}
                      download={previewFile.split("/").pop()}
                      target="_blank"
                      rel="noreferrer"
                      className="btn btn-primary"
                      style={{ textDecoration: "none" }}
                    >
                      Télécharger le fichier
                    </a>
                  </div>
                );
              }
              return (
                <div style={{ padding: "1rem" }}>
                  <Document
                    file={previewBlobUrl}
                    onLoadSuccess={({ numPages }) => { setNumPages(numPages); setIsLoading(false); }}
                    onLoadError={(err) => {
                      console.error("React-pdf error:", err);
                      setError(err.message || String(err));
                      setIsLoading(false);
                    }}
                    loading={
                      <div style={{ padding: "2rem" }}>
                        Chargement du PDF...
                      </div>
                    }
                    error={
                      <div style={{ padding: "2rem", color: "var(--danger)" }}>
                        Impossible de charger le PDF.
                      </div>
                    }
                  >
                    {Array.from(new Array(numPages || 0), (el, index) => (
                      <div
                        key={`page_${index + 1}`}
                        style={{
                          marginBottom: "2rem",
                          boxShadow: "0 4px 6px rgba(0,0,0,0.1)",
                        }}
                      >
                        <Page
                          pageNumber={index + 1}
                          scale={scale}
                          renderTextLayer={true}
                          renderAnnotationLayer={true}
                        />
                      </div>
                    ))}
                  </Document>
                </div>
              );
            })()}
          </div>
        </div>
      </div>
    </div>
  );
};

export default FilePreviewModal;
</file>

<file path="apps/admin/src/components/InternalChatTab.jsx">
import React, { useState, useEffect, useRef } from "react";
import { getSafeApiUrl, apiFetch } from "../utils/helpers";
import { Send, User, MessageSquare, Plus, ArrowLeft } from "lucide-react";

export default function InternalChatTab({ currentUser, users, showToast }) {
  const [conversations, setConversations] = useState([]);
  const [selectedContact, setSelectedContact] = useState(null);
  const [messages, setMessages] = useState([]);
  const [loading, setLoading] = useState(true);
  const [messageText, setMessageText] = useState("");
  const [isSending, setIsSending] = useState(false);
  const [showNewChat, setShowNewChat] = useState(false);
  const [filterQuery, setFilterQuery] = useState("");
  const messagesEndRef = useRef(null);

  const fetchConversations = async () => {
    try {
      const res = await apiFetch("/api/crm/messages/interne/conversations");
      const data = await res.json();
      if (data.success) {
        setConversations(data.conversations);
      }
    } catch (e) {
      console.error(e);
      showToast("Erreur lors du chargement des conversations", "error");
    } finally {
      setLoading(false);
    }
  };

  const fetchThread = async (contactEmail) => {
    try {
      const res = await apiFetch(
        `/api/crm/messages/interne/conversations/${contactEmail}`,
      );
      const data = await res.json();
      if (data.success) {
        setMessages(data.messages);
      }
    } catch (e) {
      console.error(e);
      showToast("Erreur lors du chargement des messages", "error");
    }
  };

  useEffect(() => {
    fetchConversations();
    const interval = setInterval(() => {
      fetchConversations();
      if (selectedContact) {
        fetchThread(selectedContact.email);
      }
    }, 15000); // Polling every 15s
    return () => clearInterval(interval);
  }, [selectedContact]);

  useEffect(() => {
    if (selectedContact) {
      fetchThread(selectedContact.email);
    } else {
      setMessages([]);
    }
  }, [selectedContact]);

  useEffect(() => {
    messagesEndRef.current?.scrollIntoView({ behavior: "smooth" });
  }, [messages]);

  const handleSendMessage = async (e) => {
    e.preventDefault();
    if (!messageText.trim() || !selectedContact) return;

    setIsSending(true);
    try {
      const res = await apiFetch("/api/crm/messages/interne", "POST", {
        bodyText: messageText,
        assignedToId: selectedContact.id,
        subType: "Message direct",
        objet: "Message Interne",
      });

      const data = await res.json();

      if (res.ok && data.success) {
        setMessageText("");
        await fetchThread(selectedContact.email);
        await fetchConversations();
      } else {
        showToast(data.error || "Erreur lors de l'envoi", "error");
      }
    } catch (e) {
      console.error(e);
      showToast("Erreur lors de l'envoi", "error");
    } finally {
      setIsSending(false);
    }
  };

  const handleSelectNewContact = (userId) => {
    const user = users.find((u) => u.id === userId);
    if (!user) return;

    const existing = conversations.find((c) => c.contact.email === user.email);
    if (existing) {
      setSelectedContact(existing.contact);
    } else {
      setSelectedContact({
        id: user.id,
        name: user.name,
        email: user.email,
        profile: user.profile,
      });
      setMessages([]);
    }
    setShowNewChat(false);
  };

  if (loading && conversations.length === 0) {
    return (
      <div style={{ padding: "2rem", textAlign: "center" }}>Chargement...</div>
    );
  }

  return (
    <div
      style={{
        display: "flex",
        height: "70vh",
        background: "#FFF",
        borderRadius: "8px",
        border: "1px solid var(--border)",
        overflow: "hidden",
        marginTop: "1rem",
      }}
    >
      {/* Sidebar: Conversations List */}
      <div
        style={{
          width: "320px",
          borderRight: "1px solid var(--border)",
          display: "flex",
          flexDirection: "column",
          background: "#F8FAFC",
        }}
      >
        <div
          style={{
            padding: "1rem",
            borderBottom: "1px solid var(--border)",
            display: "flex",
            justifyContent: "space-between",
            alignItems: "center",
          }}
        >
          <h3 style={{ margin: 0, fontSize: "1.1rem", fontWeight: 700, color: "var(--text-main)" }}>
            Interne
          </h3>
          <button
            onClick={() => setShowNewChat(true)}
            style={{
              padding: "0.45rem 0.85rem",
              display: "flex",
              gap: "0.3rem",
              alignItems: "center",
              fontSize: "0.85rem",
              background: "#1E3A8A",
              color: "#FFF",
              border: "none",
              borderRadius: "6px",
              cursor: "pointer",
              fontWeight: 600,
            }}
          >
            + Écrire
          </button>
        </div>

        {/* Filter Input */}
        <div style={{ padding: "0.75rem 1rem", borderBottom: "1px solid var(--border)" }}>
          <input
            type="text"
            placeholder="Filtrer les collègues..."
            value={filterQuery}
            onChange={(e) => setFilterQuery(e.target.value)}
            style={{
              width: "100%",
              padding: "0.45rem 0.75rem",
              borderRadius: "6px",
              border: "1px solid var(--border)",
              background: "#FFF",
              fontSize: "0.85rem",
              boxSizing: "border-box",
              outline: "none",
            }}
          />
        </div>

        {showNewChat ? (
          <div style={{ padding: "1rem", flex: 1, overflowY: "auto" }}>
            <div
              style={{
                display: "flex",
                alignItems: "center",
                gap: "0.5rem",
                marginBottom: "1rem",
              }}
            >
              <button
                onClick={() => setShowNewChat(false)}
                style={{
                  background: "none",
                  border: "none",
                  cursor: "pointer",
                  display: "flex",
                  color: "var(--text-main)",
                }}
              >
                <ArrowLeft size={16} />
              </button>
              <h4 style={{ margin: 0, color: "var(--text-main)", fontSize: "0.95rem" }}>À qui ?</h4>
            </div>
            {users
              .filter(
                (u) => u.id !== currentUser?.id && u.id !== "MASTER-ADMIN",
              )
              .filter(
                (u) =>
                  !filterQuery ||
                  (u.name || "").toLowerCase().includes(filterQuery.toLowerCase()) ||
                  (u.email || "").toLowerCase().includes(filterQuery.toLowerCase()) ||
                  (u.role?.name || u.role || "").toLowerCase().includes(filterQuery.toLowerCase())
              )
              .map((u) => (
                <div
                  key={u.id}
                  onClick={() => handleSelectNewContact(u.id)}
                  style={{
                    padding: "0.75rem",
                    borderBottom: "1px solid var(--border)",
                    cursor: "pointer",
                    display: "flex",
                    alignItems: "center",
                    gap: "0.75rem",
                    borderRadius: "6px",
                    marginBottom: "0.25rem",
                    background: "white",
                  }}
                >
                  <div
                    style={{
                      width: "36px",
                      height: "36px",
                      borderRadius: "50%",
                      background: "#1E3A8A",
                      color: "white",
                      display: "flex",
                      alignItems: "center",
                      justifyContent: "center",
                      fontWeight: "bold",
                    }}
                  >
                    {u.name.charAt(0).toUpperCase()}
                  </div>
                  <div>
                    <div style={{ fontWeight: 600, fontSize: "0.9rem", color: "var(--text-main)" }}>
                      {u.name}
                    </div>
                    <div
                      style={{
                        fontSize: "0.75rem",
                        color: "var(--text-muted)",
                      }}
                    >
                      {u.role?.name || u.role}
                    </div>
                  </div>
                </div>
              ))}
          </div>
        ) : (
          <div style={{ flex: 1, overflowY: "auto" }}>
            {conversations
              .filter(
                (conv) =>
                  !filterQuery ||
                  (conv.contact?.name || "").toLowerCase().includes(filterQuery.toLowerCase()) ||
                  (conv.contact?.email || "").toLowerCase().includes(filterQuery.toLowerCase())
              )
              .length === 0 ? (
              <div
                style={{
                  padding: "2rem 1rem",
                  textAlign: "center",
                  color: "var(--text-muted)",
                  fontSize: "0.9rem",
                }}
              >
                {filterQuery
                  ? "Aucun collègue ne correspond à votre recherche."
                  : 'Aucune conversation. Cliquez sur "Écrire" pour commencer.'}
              </div>
            ) : (
              conversations
                .filter(
                  (conv) =>
                    !filterQuery ||
                    (conv.contact?.name || "").toLowerCase().includes(filterQuery.toLowerCase()) ||
                    (conv.contact?.email || "").toLowerCase().includes(filterQuery.toLowerCase())
                )
                .map((conv, idx) => {
                  const isSelected = selectedContact?.email === conv.contact.email;
                  return (
                    <div
                      key={idx}
                      onClick={() => setSelectedContact(conv.contact)}
                      style={{
                        padding: "0.85rem 1rem",
                        margin: "0.35rem 0.5rem",
                        borderRadius: "6px",
