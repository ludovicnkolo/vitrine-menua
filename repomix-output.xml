                                        color: getStatusBadge(m.status).color,
                                        whiteSpace: "nowrap",
                                      }
                                    : {
                                        
                                        color: getStatusBadge(m.status).color,
                                      }
                                }
                              >
                                {getDisplayStatus(m.status, t)}
                              </span>
                            </td>
                            <td>
                              <div
                                className="truncate-name"
                                style={{ maxWidth: "100%" }}
                                title={col2}
                              >
                                {col2}
                              </div>
                            </td>
                            <td>
                              <div
                                className="truncate-name"
                                style={{
                                  color: "var(--text-muted)",
                                  maxWidth: "100%",
                                }}
                                title={col3}
                              >
                                {col3}
                              </div>
                            </td>
                            {(tab !== "personnel") && (
                              <td>
                                <span
                                  style={
                                    tab === "message"
                                      ? {
                                          padding: "0.25rem 0.5rem",
