<file path="apps/backend/src/routes/crm/notifications.js">
const express = require("express");
const prisma = require("../../prisma");
const router = express.Router();
const { authenticateJWT } = require("../../middlewares/auth");

router.use(authenticateJWT);

// GET /api/crm/notifications — liste des notifications de l'utilisateur connecté
router.get("/notifications", async (req, res) => {
  try {
    const userId = req.user.id;
    const onlyUnread = req.query.unread === "true";

    const where = { userId };
    if (onlyUnread) where.isRead = false;

    const notifications = await prisma.notification.findMany({
      where,
      orderBy: { createdAt: "desc" },
      take: 50,
    });

    const unreadCount = await prisma.notification.count({
      where: { userId, isRead: false },
    });

    res.json({ notifications, unreadCount });
  } catch (err) {
    console.error(err);
    res.status(500).json({ error: err.message });
  }
});

// PATCH /api/crm/notifications/:id/read — marquer une notification comme lue
router.patch("/notifications/:id/read", async (req, res) => {
  try {
    const userId = req.user.id;
    const notif = await prisma.notification.findUnique({
      where: { id: req.params.id },
    });
    if (!notif || notif.userId !== userId) {
      return res.status(403).json({ error: "Accès refusé." });
    }
    await prisma.notification.update({
      where: { id: req.params.id },
      data: { isRead: true },
    });
    res.json({ success: true });
  } catch (err) {
    res.status(500).json({ error: err.message });
  }
});

// PATCH /api/crm/notifications/read-all — marquer toutes comme lues
router.patch("/notifications/read-all", async (req, res) => {
  try {
    const userId = req.user.id;
    await prisma.notification.updateMany({
      where: { userId, isRead: false },
      data: { isRead: true },
    });
    res.json({ success: true });
  } catch (err) {
    res.status(500).json({ error: err.message });
  }
});

module.exports = router;
</file>

<file path="apps/backend/src/services/ImapService.js">
const imaps = require("imap-simple");
const { simpleParser } = require("mailparser");
const { PrismaClient } = require("@prisma/client");
const crypto = require("node:crypto");
const { uploadToS3 } = require("./s3Service");
const prisma = new PrismaClient();

const IMAP_CONFIG = {
  imap: {
    user: process.env.IMAP_USER,
    password: process.env.IMAP_PASSWORD,
    host: process.env.IMAP_HOST || "imap.ovh.net",
    port: process.env.IMAP_PORT
      ? Number.parseInt(process.env.IMAP_PORT, 10)
      : 993,
    tls: true,
    authTimeout: 10000,
    tlsOptions: { rejectUnauthorized: false },
  },
};

class ImapService {
  /**
   * Se connecte à la boîte mail publique et récupère les nouveaux messages.
   */
  static async fetchNewEmails() {
    let connection;
    try {
      console.log(
        "🔄 Tentative de connexion au serveur IMAP (Boîte Publique)...",
      );
      connection = await imaps.connect(IMAP_CONFIG);
      await connection.openBox("INBOX");

      // On cherche les emails non lus (UNSEEN)
      const searchCriteria = ["UNSEEN"];
      const fetchOptions = { bodies: ["HEADER", "TEXT", ""], markSeen: true };

      const messages = await connection.search(searchCriteria, fetchOptions);
      console.log(`📥 ${messages.length} nouvel(s) email(s) trouvé(s).`);

      for (const item of messages) {
        const allInfo = item.parts.find((part) => part.which === "");
        const idHeader = item.parts.find((part) => part.which === "HEADER");

        // Parse du contenu du mail
        const parsedMail = await simpleParser(allInfo.body);

        const randomMsgHex = crypto.randomBytes(4).toString("hex");
        const messageId =
          parsedMail.messageId || `msg_${Date.now()}_${randomMsgHex}`;
        const fromEmail =
          parsedMail.from?.value[0]?.address || "inconnu@domaine.com";
        const fromName = parsedMail.from?.value[0]?.name || fromEmail;
        const subject = parsedMail.subject || "Sans objet";
        const bodyText = parsedMail.text || "";
        const bodyHtml = parsedMail.html || "";

        // -- EXTRACTION DES PIECES JOINTES -> UPLOAD S3 --
        let savedAttachmentName = null;
        if (parsedMail.attachments && parsedMail.attachments.length > 0) {
          const att = parsedMail.attachments[0];
          try {
            const safeName = (att.filename || "piece_jointe").replace(
              /[^a-zA-Z0-9.-]/g,
              "_",
            );
            const randomAttHex = crypto.randomBytes(8).toString("hex");
            const filename = `${Date.now()}-${randomAttHex}-${safeName}`;
            const s3Key = `formulaires/${filename}`;
            await uploadToS3(
              att.content,
              s3Key,
              att.contentType || "application/octet-stream",
            );
            savedAttachmentName = s3Key; // Stocke le chemin complet bucket/filename
            console.log(`[+] Pièce jointe uploadée sur S3 : ${s3Key}`);
          } catch (err) {
            console.error("[-] Erreur upload pièce jointe S3 :", err);
          }
        }

        // 1. Déduplication : Est-ce qu'on l'a déjà stocké ?
        const existingMessage = await prisma.message.findUnique({
          where: { messageId },
        });

        if (existingMessage) {
          console.log(`⚠️ Email ignoré (Déjà stocké) : ${subject}`);
          continue;
        }

        // 2. Identification : L'expéditeur est-il un Client connu ?
        const existingClient = await prisma.client.findUnique({
          where: { email: fromEmail },
        });

        // 3. Sauvegarde en BDD
        const newMessage = await prisma.message.create({
          data: {
            messageId,
            subject,
            bodyText,
            bodyHtml,
            fromEmail,
            fromName,
            attachment: savedAttachmentName,
            isAnonyme: !existingClient,
            clientId: existingClient ? existingClient.id : null,
            status: "NOUVEAU", // Statut initial demandé par l'admin
          },
        });

        console.log(
          `✅ Nouvel email enregistré : [${subject}] de ${fromEmail} ${existingClient ? "(Client Reconnu)" : "(Anonyme)"}`,
        );
      }

      connection.end();
      console.log("🏁 Synchronisation IMAP terminée avec succès.");
    } catch (error) {
      console.error("❌ Erreur lors de la synchronisation IMAP :", error);
      if (connection) connection.end();
    }
  }

  /**
   * Lance le "Cron Job" qui écoute la boîte mail toutes les 2 minutes
   */
  static startSyncJob() {
    console.log(
      "⏰ Démarrage du Job de synchronisation Email (Toutes les 2 minutes)...",
    );
    setInterval(
      async () => {
        await this.fetchNewEmails();
      },
      2 * 60 * 1000,
    ); // 2 minutes
  }
}

module.exports = ImapService;
</file>

<file path="apps/backend/src/services/storageCron.js">
const { PrismaClient } = require("@prisma/client");
const prisma = new PrismaClient();
const {
  S3Client,
  ListObjectsV2Command,
  DeleteObjectCommand,
} = require("@aws-sdk/client-s3");

const s3Client = new S3Client({
  endpoint: process.env.S3_ENDPOINT,
  region: process.env.S3_REGION || "eu-west-par",
  credentials: {
    accessKeyId: process.env.S3_ACCESS_KEY,
    secretAccessKey: process.env.S3_SECRET_KEY,
  },
});

const BUCKET_NAME = process.env.S3_BUCKET;

async function processStorageCleanup() {
  console.log(
    "[Storage Cron] Démarrage du nettoyage des fichiers orphelins (GED & CMS)...",
  );
  try {
    if (!BUCKET_NAME) {
      console.error("[Storage Cron] S3_BUCKET non défini.");
      return;
    }

    // ─── 1. LISTER LES FICHIERS S3 ───
    const listS3Files = async (prefix) => {
      let isTruncated = true;
      let continuationToken = undefined;
      const keys = [];
      while (isTruncated) {
        const command = new ListObjectsV2Command({
          Bucket: BUCKET_NAME,
          Prefix: prefix,
          ContinuationToken: continuationToken,
        });
        const response = await s3Client.send(command);
        if (response.Contents) {
          // Filtrer les objets pour ignorer ceux modifiés il y a moins de 24h (délai de grâce)
          const now = Date.now();
          const oneDay = 24 * 60 * 60 * 1000;
          response.Contents.forEach((item) => {
            if (now - item.LastModified.getTime() > oneDay) {
              keys.push(item.Key);
            }
          });
        }
        isTruncated = response.IsTruncated;
        continuationToken = response.NextContinuationToken;
      }
      return keys;
    };

    const gedKeys = await listS3Files("ged/");
    const cmsKeys = await listS3Files("cms/images/");

    console.log(
      `[Storage Cron] Trouvés dans S3 (> 24h) : ${gedKeys.length} GED, ${cmsKeys.length} CMS.`,
    );

    // ─── 2. RÉCUPÉRER LES RÉFÉRENCES BDD ───

    // A. Documents (GED)
    const documents = await prisma.document.findMany({ select: { url: true } });
    const dbGedUrls = new Set(documents.map((doc) => doc.url).filter(Boolean));

    // B. Publications (CMS)
    const publications = await prisma.publication.findMany({
      select: { coverImage: true, sections: true },
    });
    const dbCmsUrls = new Set();
    publications.forEach((pub) => {
      if (pub.coverImage) dbCmsUrls.add(pub.coverImage);
      if (pub.sections) {
        try {
          const secs =
            typeof pub.sections === "string"
              ? JSON.parse(pub.sections)
              : pub.sections;
          if (Array.isArray(secs)) {
            secs.forEach((s) => {
              if (s.imageKey) dbCmsUrls.add(s.imageKey);
            });
          }
        } catch (e) {}
      }
    });

    // ─── 3. IDENTIFIER LES ORPHELINS ───
    const gedOrphans = gedKeys.filter((key) => !dbGedUrls.has(key));
    const cmsOrphans = cmsKeys.filter((key) => !dbCmsUrls.has(key));
    const allOrphans = [...gedOrphans, ...cmsOrphans];

    console.log(
      `[Storage Cron] Orphelins identifiés : ${gedOrphans.length} GED, ${cmsOrphans.length} CMS.`,
    );

    if (allOrphans.length === 0) return;

    // ─── 4. SUPPRIMER LES ORPHELINS ───
    let deletedCount = 0;
    for (const orphanKey of allOrphans) {
      try {
        await s3Client.send(
          new DeleteObjectCommand({
            Bucket: BUCKET_NAME,
            Key: orphanKey,
          }),
        );
        deletedCount++;
        console.log(`[Storage Cron] Supprimé: ${orphanKey}`);
      } catch (err) {
        console.error(
          `[Storage Cron] Erreur lors de la suppression de ${orphanKey}:`,
          err.message,
        );
      }
    }

    console.log(
      `[Storage Cron] Nettoyage terminé. ${deletedCount} fichiers supprimés.`,
    );
  } catch (error) {
    console.error("[Storage Cron] Erreur générale lors du nettoyage:", error);
  }
}

function startStorageCron() {
  // Exécuter une fois par jour (24 heures)
  const INTERVAL_24H = 24 * 60 * 60 * 1000;
  setInterval(processStorageCleanup, INTERVAL_24H);

  // Exécuter au démarrage (après un petit délai pour ne pas ralentir le startup)
  setTimeout(processStorageCleanup, 15000);
}

module.exports = { startStorageCron };
</file>

