                                          fontSize: "0.72rem",
                                          fontWeight: 400,
                                          background: typeBadgeBg,
                                          color: typeBadgeColor,
                                        }
                                      : {
                                          
                                          color: typeBadgeColor,
                                        }
                                  }
                                >
                                  {typeBadgeText}
                                </span>
                              </td>
                            )}
                            <td
                              className="table-date-cell"
                              style={{
                                color: "var(--text-muted)",
                                width: "160px",
                              }}
                            >
                              {formatDate(m.createdAt)}
                            </td>
                            <td>
                              <div
                                style={{
                                  display: "flex",
                                  flexDirection: "column",
                                  gap: "0.25rem",
                                  alignItems: "center",
                                }}
