    {
      "id": "b5fa6a91-20f3-40f1-9717-81b806dc120b",
      "messageId": "<CANmTpSnj8r47VKjdFYshSBOd0fckRd13CjS8yYEgVto-QdTXkQ@mail.gmail.com>",
      "type": "PERSONNEL",
