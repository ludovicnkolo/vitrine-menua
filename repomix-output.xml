      )}

      {/* Toast Notification */}
      {toast.show && (
        <div
          style={{
            position: "fixed",
            bottom: "20px",
            right: "20px",
            background: toast.type === "error" ? "#FEE2E2" : "#DCFCE7",
            color: toast.type === "error" ? "#991B1B" : "#166534",
