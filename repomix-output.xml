                          display: "flex",
                          alignItems: "center",
                          justifyContent: "center",
                          fontWeight: "bold",
                          flexShrink: 0,
                          marginTop: "2px",
                        }}
                      >
                        {conv.contact.name.charAt(0).toUpperCase()}
                      </div>
                      <div style={{ flex: 1, minWidth: 0 }}>
                        <div
                          style={{
                            display: "flex",
                            justifyContent: "space-between",
                            alignItems: "center",
                            marginBottom: "0.15rem",
                          }}
                        >
                          <span
                            style={{
                              fontWeight: isSelected ? 700 : 600,
                              color: "var(--text-main)",
                              fontSize: "0.9rem",
                              whiteSpace: "nowrap",
                              overflow: "hidden",
                              textOverflow: "ellipsis",
                            }}
                          >
                            {conv.contact.name}
                          </span>
                          <span
                            style={{
                              fontSize: "0.7rem",
                              color: "var(--text-muted)",
                            }}
                          >
                            {new Date(
                              conv.lastMessage.createdAt,
                            ).toLocaleDateString()}
                          </span>
                        </div>
                        <div
                          style={{
                            fontSize: "0.8rem",
                            color: conv.unreadCount > 0 ? "#854D0E" : "#64748B",
                            fontWeight: conv.unreadCount > 0 ? 600 : 400,
                            whiteSpace: "nowrap",
                            overflow: "hidden",
                            textOverflow: "ellipsis",
                            marginBottom: isSelected ? "0.3rem" : "0",
                          }}
                        >
                          {conv.lastMessage.bodyText || "Document joint"}
                        </div>
                        {isSelected && (
                          <div style={{ marginTop: "0.2rem" }}>
                            <span
                              style={{
                                fontSize: "0.68rem",
                                fontWeight: 800,
                                color: "#2563EB",
                                letterSpacing: "0.03em",
                              }}
                            >
                              CONVERSATION ACTIVE
                            </span>
                          </div>
                        )}
                        {conv.unreadCount > 0 && !isSelected && (
                          <span
                            style={{
                              background: "#EAB308",
                              color: "white",
                              fontSize: "0.7rem",
                              fontWeight: "bold",
                              padding: "0.1rem 0.4rem",
                              borderRadius: "10px",
                              display: "inline-block",
                              marginTop: "0.25rem",
                            }}
                          >
                            {conv.unreadCount} non lu
                          </span>
                        )}
                      </div>
                    </div>
                  );
                })
            )}
          </div>
        )}
      </div>

      {/* Main Chat Area */}
      <div style={{ flex: 1, display: "flex", flexDirection: "column" }}>
        {selectedContact ? (
          <>
            <div
              style={{
                padding: "1rem 1.5rem",
                borderBottom: "1px solid var(--border)",
                background: "#FFF",
                display: "flex",
                alignItems: "center",
                gap: "1rem",
              }}
            >
              <div
                style={{
                  width: "40px",
                  height: "40px",
                  borderRadius: "50%",
                  background: "#1E3A8A",
                  color: "white",
                  display: "flex",
                  alignItems: "center",
                  justifyContent: "center",
                  fontWeight: "bold",
                }}
              >
                {selectedContact.name.charAt(0).toUpperCase()}
              </div>
              <div>
                <h3 style={{ margin: 0, fontSize: "1.05rem", fontWeight: 700, color: "var(--text-main)" }}>
                  {selectedContact.name}
                </h3>
                <span
                  style={{ fontSize: "0.8rem", color: "#64748B" }}
                >
                  <span style={{ color: "#16A34A" }}>● En ligne</span> • Vos messages internes
                </span>
              </div>
            </div>

            <div
              style={{
                flex: 1,
                overflowY: "auto",
                padding: "1.5rem",
                display: "flex",
                flexDirection: "column",
                gap: "1rem",
                background: "#F8FAFC",
              }}
            >
              <div
                style={{
                  maxWidth: "380px",
                  margin: "0.5rem auto 1rem",
                  padding: "1rem 1.5rem",
                  background: "#FFF",
                  border: "1px solid #E2E8F0",
                  borderRadius: "8px",
                  textAlign: "center",
                  boxShadow: "0 1px 3px rgba(0,0,0,0.02)",
                }}
              >
                <div style={{ fontWeight: 700, fontSize: "0.95rem", color: "var(--text-main)", marginBottom: "0.35rem" }}>
                  Vos messages internes
                </div>
                <div style={{ fontSize: "0.8rem", color: "#64748B" }}>
                  Sélectionnez une conversation ou écrivez un nouveau message.
                </div>
              </div>

              {messages.map((msg) => {
                const isMine = msg.email === currentUser?.email;
                return (
                  <div
                    key={msg.id}
                    style={{
                      display: "flex",
                      flexDirection: "column",
                      alignItems: isMine ? "flex-end" : "flex-start",
                    }}
                  >
                    <div
                      style={{
                        maxWidth: "70%",
                        padding: "0.75rem 1rem",
                        borderRadius: "8px",
                        background: isMine ? "#1E3A8A" : "#F1F5F9",
                        color: isMine ? "#FFF" : "var(--text-main)",
                        boxShadow: "0 1px 2px rgba(0,0,0,0.05)",
                        border: isMine ? "none" : "1px solid #E2E8F0",
                      }}
                    >
                      <div
                        style={{
                          fontSize: "0.95rem",
                          whiteSpace: "pre-wrap",
                          wordBreak: "break-word",
                        }}
                      >
                        {msg.bodyText}
                      </div>
                    </div>
                    <span
                      style={{
                        fontSize: "0.7rem",
                        color: "var(--text-muted)",
                        marginTop: "0.25rem",
                      }}
                    >
                      {new Date(msg.createdAt).toLocaleDateString([], {
                        day: "2-digit",
                        month: "2-digit",
                        year: "numeric",
                      })}
                    </span>
                  </div>
                );
              })}
              <div ref={messagesEndRef} />
            </div>

            <div
              style={{
                padding: "1rem 1.5rem",
                borderTop: "1px solid var(--border)",
                background: "#FFF",
              }}
            >
              <form
                onSubmit={handleSendMessage}
                style={{ display: "flex", gap: "0.75rem", alignItems: "center" }}
              >
                <input
                  type="text"
                  value={messageText}
                  onChange={(e) => setMessageText(e.target.value)}
                  placeholder={`Écrivez votre message à ${selectedContact.name}... (Entrée pour envoyer)`}
                  style={{
                    flex: 1,
                    padding: "0.65rem 1rem",
                    borderRadius: "6px",
                    border: "1px solid #CBD5E1",
                    outline: "none",
                    fontSize: "0.9rem",
                    background: "#FFF",
                  }}
                />
                <button
                  type="submit"
                  disabled={isSending || !messageText.trim()}
                  style={{
                    padding: "0.65rem 1.5rem",
                    borderRadius: "6px",
                    background: "#1E3A8A",
                    color: "white",
                    border: "none",
                    display: "flex",
                    alignItems: "center",
                    justifyContent: "center",
                    fontWeight: 600,
                    fontSize: "0.9rem",
                    cursor:
                      isSending || !messageText.trim()
                        ? "not-allowed"
                        : "pointer",
                    opacity: isSending || !messageText.trim() ? 0.7 : 1,
                  }}
                >
                  Envoyer
                </button>
              </form>
            </div>
          </>
        ) : (
          <div
            style={{
              flex: 1,
              display: "flex",
              flexDirection: "column",
              alignItems: "center",
              justifyContent: "center",
              color: "var(--text-muted)",
            }}
          >
            <MessageSquare
              size={48}
              style={{ marginBottom: "1rem", opacity: 0.5 }}
            />
            <h2 style={{ fontSize: "1.25rem", fontWeight: 500, margin: 0 }}>
              Vos messages internes
