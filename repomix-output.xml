                {user.name}
              </div>
              <div
                style={{ fontSize: "0.75rem", color: "rgba(255,255,255,0.6)" }}
              >
                {user.role}
              </div>
            </div>
          </div>
          {/* Sélecteur de langue déplacé vers Espace système -> Configuration */}
          <button
            type="button"
            onClick={handleLogout}
            className="btn btn-outline"
            style={{
              width: "100%",
              borderColor: "rgba(255,255,255,0.2)",
              color: "white",
              display: "flex",
              gap: "0.5rem",
              justifyContent: "center",
              alignItems: "center",
            }}
          >
            <LogOut size={16} /> {t("nav.logout")}
          </button>
        </div>
      </aside>

      {/* Main Content */}
      <main className="main-content">
        {/* Top bar with notification bell */}
        <div
          className="topbar-header"
          style={{
            display: "flex",
            justifyContent: "space-between",
            alignItems: "center",
            padding: "0.75rem 1.5rem 0",
            position: "sticky",
            top: 0,
            zIndex: 100,
            background: "var(--bg-main, #f8fafc)",
            borderBottom: "1px solid transparent",
          }}
        >
          <button className="mobile-menu-btn" onClick={() => setIsSidebarOpen(true)}>
            <Menu size={24} />
          </button>
          <div style={{ marginLeft: "auto" }}>
            <NotificationBell />
          </div>
        </div>
        <div className="page-content">
          <Routes>
            {/* Routes conditionnelles selon rôle */}
            {canSeeGlobal && <Route path="/" element={<DashboardPage />} />}
            {/* AdminTech → Espace système | Autres rôles sans global → Espace travail */}
            {!canSeeGlobal && isAdminTech && (
              <Route
                path="/"
                element={<SystemSpacePage userRole={userRoleForPages} />}
              />
            )}
            {!canSeeGlobal && !isAdminTech && (
              <Route
                path="/"
                element={<WorkspacePage userRole={userRoleForPages} />}
              />
            )}

            {canSeeMessage && (
              <Route
                path="/inbox"
                element={<InboxPage userRole={userRoleForPages} />}
              />
            )}
            {canSeeWorkspace && (
              <Route
                path="/workspace"
                element={<WorkspacePage userRole={userRoleForPages} />}
              />
            )}
            {canSeeUsers && (
              <Route path="/users-space" element={<UsersSpacePage />} />
            )}
            {canSeeSystem && (
              <Route
                path="/system-space"
                element={<SystemSpacePage userRole={userRoleForPages} />}
              />
            )}
            {canSeeCMS && <Route path="/cms" element={<CMSPage />} />}

            {/* Redirections sécurisées pour anciennes routes (bloque l'accès non autorisé par URL directe) */}
            <Route
              path="/dossiers"
              element={
                canSeeWorkspace ? (
                  <Navigate to="/workspace" replace />
                ) : (
                  <Navigate to="/" replace />
                )
              }
            />
            <Route
              path="/taches"
              element={
                canSeeWorkspace ? (
                  <Navigate to="/workspace" replace />
                ) : (
                  <Navigate to="/" replace />
                )
              }
            />
            <Route
              path="/tasks"
              element={
                canSeeWorkspace ? (
                  <Navigate to="/workspace" replace />
                ) : (
                  <Navigate to="/" replace />
                )
              }
            />
            <Route
              path="/users"
              element={
                canSeeUsers ? (
                  <Navigate to="/users-space" replace />
                ) : (
                  <Navigate to="/" replace />
                )
              }
            />
            <Route
              path="/roles"
              element={
                canSeeSystem ? (
                  <Navigate to="/system-space" replace />
                ) : (
                  <Navigate to="/" replace />
                )
              }
            />
            <Route
              path="/audit"
              element={
                canSeeSystem ? (
                  <Navigate to="/system-space" replace />
                ) : (
                  <Navigate to="/" replace />
                )
              }
            />
            <Route path="/settings" element={<Navigate to="/" replace />} />
            <Route path="*" element={<Navigate to="/" replace />} />
          </Routes>
        </div>
      </main>
    </div>
  );
}

export default App;
