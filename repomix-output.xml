          >
            ✕
          </button>
        </div>
      )}
      {/* ─── Modale saisie "À rappeler" / "Entretien" ─── */}
      <InboxRappelModal
        rappelModal={rappelModal}
        setRappelModal={setRappelModal}
        handleUpdateMultiple={handleUpdateMultiple}
      />
    </div>
  );
};

export default InboxPage;
