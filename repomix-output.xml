const { PrismaClient } = require("@prisma/client");
const fs = require("fs");
const path = require("path");
const { uploadToS3 } = require("./s3Service");

const prisma = new PrismaClient();

async function syncLocalUploadsToS3() {
  console.log(
    "[S3 Sync] Démarrage de la synchronisation des uploads locaux vers S3...",
  );
  try {
    const publications = await prisma.publication.findMany({
      where: {
        OR: [
          { coverImage: { contains: "/uploads/cms/images/" } },
          { sections: { contains: "/uploads/cms/images/" } },
        ],
      },
    });

    if (publications.length === 0) {
      console.log(
        "[S3 Sync] Aucune image locale en attente de synchronisation.",
      );
      return;
    }

    let syncCount = 0;

    for (const pub of publications) {
      let dataToUpdate = {};
      let needsUpdate = false;
      let filesToDelete = [];

      // 1. Process Cover Image
      if (pub.coverImage && pub.coverImage.includes("/uploads/cms/images/")) {
        const fileName = pub.coverImage.split("/").pop();
        const s3Key = await processFileToS3(fileName);
        if (s3Key) {
          dataToUpdate.coverImage = s3Key;
          needsUpdate = true;
          filesToDelete.push(fileName);
        }
      }

      // 2. Process Sections Images
      if (pub.sections && pub.sections.includes("/uploads/cms/images/")) {
        try {
          const sections = JSON.parse(pub.sections);
          let sectionsModified = false;

          for (const s of sections) {
            if (s.imageKey && s.imageKey.includes("/uploads/cms/images/")) {
              const fileName = s.imageKey.split("/").pop();
              const s3Key = await processFileToS3(fileName);
              if (s3Key) {
                s.imageKey = s3Key;
                sectionsModified = true;
                filesToDelete.push(fileName);
              }
            }
          }

          if (sectionsModified) {
            dataToUpdate.sections = JSON.stringify(sections);
            needsUpdate = true;
          }
        } catch (e) {
          console.error(
            `[S3 Sync] Erreur lors du parsing des sections (Pub ID: ${pub.id}):`,
            e.message,
          );
        }
      }

      // 3. Update DB & Delete Files
      if (needsUpdate) {
        await prisma.publication.update({
          where: { id: pub.id },
          data: dataToUpdate,
        });

        console.log(
          `[S3 Sync] Base de données mise à jour pour la publication ${pub.id}`,
        );

        for (const fileName of filesToDelete) {
          deleteLocalFiles(fileName);
        }
        syncCount++;
      }
    }

    console.log(
      `[S3 Sync] Synchronisation terminée. ${syncCount} publication(s) mise(s) à jour.`,
    );
  } catch (error) {
    console.error(
      "[S3 Sync] Erreur générale lors de la synchronisation:",
      error,
    );
  }
}

async function processFileToS3(fileName) {
  const adminPath = path.join(
    __dirname,
    "../../../admin/public/uploads/cms/images",
    fileName,
  );
  const vitrinePath = path.join(
    __dirname,
    "../../../vitrine/public/uploads/cms/images",
    fileName,
  );

  // Choose whichever exists
  let targetPath = null;
  if (fs.existsSync(adminPath)) targetPath = adminPath;
  else if (fs.existsSync(vitrinePath)) targetPath = vitrinePath;

  if (!targetPath) {
    console.warn(
      `[S3 Sync] Fichier local introuvable pour synchronisation : ${fileName}`,
    );
    return null; // Can't upload if it doesn't exist
  }

  try {
    const buffer = fs.readFileSync(targetPath);
    // Determine mime type based on extension
    const ext = path.extname(fileName).toLowerCase();
    let mimetype = "application/octet-stream";
    if (ext === ".jpg" || ext === ".jpeg") mimetype = "image/jpeg";
    else if (ext === ".png") mimetype = "image/png";
    else if (ext === ".gif") mimetype = "image/gif";
    else if (ext === ".webp") mimetype = "image/webp";
    else if (ext === ".svg") mimetype = "image/svg+xml";

    const s3Key = `cms/images/${fileName}`;
    await uploadToS3(buffer, s3Key, mimetype);
    console.log(`[S3 Sync] Succès de l'upload vers S3 : ${s3Key}`);
    return s3Key;
  } catch (err) {
    console.error(`[S3 Sync] Échec de l'upload pour ${fileName}:`, err.message);
    return null;
  }
}

function deleteLocalFiles(fileName) {
  const adminPath = path.join(
    __dirname,
    "../../../admin/public/uploads/cms/images",
    fileName,
  );
  const vitrinePath = path.join(
    __dirname,
    "../../../vitrine/public/uploads/cms/images",
    fileName,
  );

  try {
    if (fs.existsSync(adminPath)) {
      fs.unlinkSync(adminPath);
      console.log(`[S3 Sync] Fichier supprimé (Admin) : ${fileName}`);
    }
    if (fs.existsSync(vitrinePath)) {
      fs.unlinkSync(vitrinePath);
      console.log(`[S3 Sync] Fichier supprimé (Vitrine) : ${fileName}`);
    }
  } catch (err) {
    console.error(
      `[S3 Sync] Erreur lors de la suppression locale de ${fileName}:`,
      err.message,
    );
  }
}

function startLocalUploadSyncCron() {
  // Exécuter toutes les 5 minutes (au lieu de 24h) pour récupérer les images en fallback local rapidement
  const INTERVAL_5MIN = 5 * 60 * 1000;
  setInterval(syncLocalUploadsToS3, INTERVAL_5MIN);

  // Exécuter une fois au démarrage après 30 secondes
  setTimeout(syncLocalUploadsToS3, 30000);
}

module.exports = { startLocalUploadSyncCron, syncLocalUploadsToS3 };
</file>

<file path="apps/backend/src/services/verifaliaCron.js">
const { PrismaClient } = require("@prisma/client");
const prisma = new PrismaClient();
const verifaliaService = require("./verifalia");

async function processVerifaliaJobs() {
  if (verifaliaService.isPaused()) {
    return; // Coupe-circuit actif : on ne fait rien pour ne pas spammer l'API ni surcharger la BDD
  }
  console.log("[Verifalia] Cron started");
  // 1. Process forms that are 'A_VERIFIER' in verifaliaStatus and have no job ID (meaning we need to submit them to Verifalia)
  const pendingSubmissions = await prisma.formulaire.findMany({
    where: {
      verifaliaStatus: "A_VERIFIER",
      verifaliaJobId: null,
      OR: [
        { verifaliaNextRetry: null },
        { verifaliaNextRetry: { lte: new Date() } },
      ],
      verifaliaRetries: { lt: 8 }, // max 8 retries total as discussed
    },
  });

  for (const form of pendingSubmissions) {
    try {
      console.log(`[Verifalia] Submitting email for form ${form.id}`);
      const job = await verifaliaService.submitVerification(form.email);
      await prisma.formulaire.update({
        where: { id: form.id },
        data: {
          verifaliaJobId: job.id,
          verifaliaStatus: job.status,
          verifaliaNextRetry: null,
        },
      });
    } catch (err) {
      console.error(`[Verifalia] Error submitting ${form.id}:`, err.message);
      let nextRetry = new Date(Date.now() + 2 * 60 * 60 * 1000); // Default 2 hours
      if (err.code === "QUOTA_EXCEEDED") {
        const tomorrow = new Date();
        tomorrow.setUTCHours(24, 0, 0, 0);
        nextRetry = tomorrow;
      }

      const retries = form.verifaliaRetries + 1;

      if (retries >= 8) {
        // Abandonner et passer en contrôle manuel
        await prisma.formulaire.update({
          where: { id: form.id },
          data: {
            verifaliaStatus: "CONTROLE_MANUEL",
            verifaliaRetries: retries,
          },
        });
      } else {
        await prisma.formulaire.update({
          where: { id: form.id },
          data: {
            verifaliaNextRetry: nextRetry,
            verifaliaRetries: retries,
          },
        });
      }
    }
  }

  // 2. Process forms that have a verifaliaJobId but are still 'A_VERIFIER' in verifaliaStatus (we need to fetch the result)
  const pendingResults = await prisma.formulaire.findMany({
    where: {
      verifaliaStatus: "A_VERIFIER",
      verifaliaJobId: { not: null },
    },
  });

  for (const form of pendingResults) {
    try {
      console.log(
        `[Verifalia] Checking job ${form.verifaliaJobId} for form ${form.id}`,
      );
      const job = await verifaliaService.getJob(form.verifaliaJobId);

      if (job.status === "Completed") {
        const entriesData = await verifaliaService.getJobEntries(
          form.verifaliaJobId,
        );
        if (entriesData && entriesData.data && entriesData.data.length > 0) {
          const result = entriesData.data[0];

          // Classification: Deliverable, Risky, Undeliverable, Unknown
          if (
            !result.isDisposableEmailAddress &&
            result.classification === "Deliverable"
          ) {
            await prisma.formulaire.update({
              where: { id: form.id },
              data: {
                verifaliaStatus: "COMPLETED_VALID",
              },
            });

            // Send deferred emails
            const fullForm = await prisma.formulaire.findUnique({
              where: { id: form.id },
              include: { contact: true, recrutement: true },
            });
            const emailService = require("./emailService");
            await emailService.sendAutoReply(fullForm.email);
            await emailService.sendAdminNotification(fullForm);
          } else if (
            result.classification === "Undeliverable" ||
            result.isDisposableEmailAddress
          ) {
            await prisma.formulaire.update({
              where: { id: form.id },
              data: {
                verifaliaStatus: "COMPLETED_INVALID",
              },
            });
          } else {
            await prisma.formulaire.update({
              where: { id: form.id },
              data: {
                verifaliaStatus:
                  result.classification === "Risky"
                    ? "COMPLETED_RISKY"
                    : "COMPLETED_UNKNOWN",
              },
            });
          }
        }
      }
    } catch (err) {
      console.error(
        `[Verifalia] Error fetching job ${form.verifaliaJobId}:`,
        err.message,
      );
      // We keep it pending. It will be retried next time.
    }
  }
}

function startVerifaliaCron() {
  // Run every 2 minutes
  setInterval(processVerifaliaJobs, 2 * 60 * 1000);
  // Also run immediately on startup
  setTimeout(processVerifaliaJobs, 5000);
}

module.exports = { startVerifaliaCron };
</file>

<file path="apps/backend/src/utils/statusRules.js">
const isSuperAdmin = (role) => role === "Super-administrateur";
const isResp = (role) => role === "Responsable opérationnel";
const isRelecteur = (role) => role === "Relecteur";
const isCollab = (role) => role === "Collaborateur";

const validateTacheStatus = (fromStatus, toStatus, role) => {
  if (!toStatus || fromStatus === toStatus) return true;
  const isSA = isSuperAdmin(role);
  const isRO = isResp(role);
  const isRel = isRelecteur(role);
  const isCol = isCollab(role);
  const isRespOrAdmin = isSA || isRO;

  const VALID_TRANSITIONS = {
    NOUVEAU: {
      allowed: ["EN_COURS", "EN_ATTENTE", "BLOQUE"],
      check: () => true
    },
    EN_COURS: {
      allowed: ["EN_RELECTURE", "BLOQUE", "EN_ATTENTE"],
      check: (t) => {
        if (t === "BLOQUE" && isCol) return false;
        return true;
      }
    },
    EN_RELECTURE: {
      allowed: ["EN_APPROBATION", "A_CORRIGER", "EN_ATTENTE"],
      check: () => isSA || isRel
    },
    EN_APPROBATION: {
      allowed: ["APPROUVEE", "A_CORRIGER", "EN_COURS"],
      check: () => isSA || isRO
    },
    APPROUVEE: {
      allowed: ["EN_COURS"],
      check: () => isSA
    },
    A_CORRIGER: {
      allowed: ["EN_COURS", "BLOQUE"],
      check: () => true
    },
    BLOQUE: {
      allowed: ["EN_COURS"],
      check: () => true
    },
    EN_ATTENTE: {
      allowed: ["EN_COURS"],
      check: () => true
    },
    TERMINE: {
      allowed: ["EN_COURS"],
      check: () => isSA
    }
  };

  const rule = VALID_TRANSITIONS[fromStatus];
  if (!rule || !rule.allowed.includes(toStatus)) return false;
  return rule.check(toStatus);
};

const validateMissionStatus = (fromStatus, toStatus, role) => {
  if (!toStatus || fromStatus === toStatus) return true;
  const isSA = isSuperAdmin(role);
  const isRO = isResp(role);
  const isRespOrAdmin = isSA || isRO;

  const VALID_TRANSITIONS = {
    NOUVEAU: {
      allowed: ["EN_COURS", "EN_ATTENTE", "BLOQUE"],
      check: () => isRespOrAdmin
    },
    EN_COURS: {
      allowed: ["TERMINE", "BLOQUE", "EN_ATTENTE"],
      check: () => isRespOrAdmin
    },
    BLOQUE: {
      allowed: ["EN_COURS"],
      check: () => isRespOrAdmin
    },
    EN_ATTENTE: {
      allowed: ["EN_COURS"],
      check: () => isRespOrAdmin
    },
    TERMINE: {
      allowed: ["EN_COURS"],
      check: () => isSA
    }
  };

  const rule = VALID_TRANSITIONS[fromStatus];
  if (!rule || !rule.allowed.includes(toStatus)) return false;
  return rule.check(toStatus);
};

const validateMessageStatus = (fromStatus, toStatus, category, role) => {
  if (!toStatus || fromStatus === toStatus) return true;
  const isSA = isSuperAdmin(role);
  const isRO = isResp(role);

  if (!isSA && !isRO && category !== "interne") return false;

  let rule = null;
  if (category === "contact") {
    rule = {
      NOUVEAU: ["A_RAPPELER", "DISCUSSION", "SANS_SUITE", "GAGNE"],
      A_RAPPELER: ["DISCUSSION", "SANS_SUITE", "GAGNE"],
      DISCUSSION: ["A_RAPPELER", "SANS_SUITE", "GAGNE"],
      SANS_SUITE: ["DISCUSSION"],
      GAGNE: []
    };
  } else if (category === "recrutement") {
    rule = {
      NOUVEAU: ["A_RAPPELER", "ENTRETIEN", "REFUSE"],
      A_RAPPELER: ["ENTRETIEN", "REFUSE"],
      ENTRETIEN: ["A_RAPPELER", "RETENU", "REFUSE"],
      RETENU: [],
      REFUSE: []
    };
  } else if (category === "interne") {
    rule = {
      NON_CONSULTE: ["CONSULTE"],
      CONSULTE: ["NON_CONSULTE"]
    };
  } else {
    rule = {
      NOUVEAU: ["A_RAPPELER", "TRAITE"],
      A_RAPPELER: ["TRAITE"],
      TRAITE: ["NOUVEAU"]
    };
  }

  const allowed = rule[fromStatus] || [];
  return allowed.includes(toStatus);
};

module.exports = {
  validateTacheStatus,
  validateMissionStatus,
  validateMessageStatus
};
</file>

