                  }}
                >
                  <Paperclip size={15} /> Documents attachés ({consultTask.documents.length})
                </div>
                <div style={{ display: "flex", flexDirection: "column", gap: "0.5rem" }}>
                  {consultTask.documents.map((doc) => (
                    <div
                      key={doc.id}
                      onClick={() => setPreviewFile(doc.url)}
                      style={{
                        padding: "0.6rem 0.85rem",
                        background: "#F8FAFC",
                        borderRadius: "6px",
                        border: "1px solid var(--border)",
                        fontSize: "0.85rem",
                        color: "var(--primary)",
                        cursor: "pointer",
                        display: "flex",
                        alignItems: "center",
                        gap: "0.5rem",
                      }}
                    >
                      <FileText size={16} />
                      <span style={{ fontWeight: 500, overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>
                        {doc.name}
                      </span>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>

        {/* Fil de corrections — visible selon le rôle et le statut */}
        <div style={{ marginTop: "1.5rem" }}>
          <FeedbackThread
            adminFeedback={consultTask.adminFeedback}
            managerFeedback={consultTask.managerFeedback}
            currentStatus={consultTask.status}
          />
        </div>

        <SmsModal
          isOpen={showSmsModal}
          onClose={() => setShowSmsModal(false)}
          contextData={{
            missionId:
              mode === "MISSION" ? consultTask.id : consultTask.missionId,
            dossierId:
              mode === "MISSION"
                ? consultTask.dossierId
                : consultTask.dossierTacheId || null,
            tacheId: mode === "TACHE" ? consultTask.id : null,
            createdById: consultTask.createdById,
            assignedToId: consultTask.assignedToId,
            reference: consultTask.reference,
          }}
        />

        <TaskConsultModal
          task={localConsultSubTask}
          onClose={() => setLocalConsultSubTask(null)}
        />
        <FilePreviewModal
          previewFile={previewFile}
          onClose={() => setPreviewFile(null)}
        />

        {/* Admin Feedback Modal — Super Admin → À améliorer */}
        <FeedbackModal
          isOpen={showAdminFeedbackModal}
          mode="admin"
          onClose={() => setShowAdminFeedbackModal(false)}
          onSubmit={(text) => handleFeedbackSubmit(text, "admin")}
          isSubmitting={isFeedbackSubmitting}
        />

        {/* Manager Feedback Modal — Contrôleur → En révision */}
        <FeedbackModal
          isOpen={showManagerFeedbackModal}
          mode="manager"
          referenceFeedback={consultTask.adminFeedback || null}
          onClose={() => setShowManagerFeedbackModal(false)}
          onSubmit={(text) => handleFeedbackSubmit(text, "manager")}
          isSubmitting={isFeedbackSubmitting}
        />

        {renderCreateTaskModal()}
      </div>
    );
  }

  return (
    <div>
      <div
        className="flex justify-between items-center mb-6"
        style={{
          display: "flex",
          justifyContent: "space-between",
          marginBottom: "1.5rem",
        }}
      >
        <div>
          <h1
            style={{
              fontSize: "1.5rem",
              fontWeight: 600,
              color: "var(--text-main)",
            }}
          >
            {mode === "MISSION" ? t("workspace.tabs.missions", "Missions") : t("workspace.tabs.taches", "Tâches")}
          </h1>
          <p style={{ color: "var(--text-muted)" }}>
            {t("task.subtitle", "Suivi opérationnel et gestion des tâches")}
          </p>
        </div>
      </div>

      <div
        style={{
          display: "flex",
          gap: "1rem",
          marginBottom: "1.5rem",
          background: "#F8FAFC",
          padding: "1rem",
          borderRadius: "8px",
          border: "1px solid var(--border)",
        }}
      >
        <div style={{ flex: 1, position: "relative" }}>
          <Search
            size={18}
            style={{
              position: "absolute",
              left: "1rem",
              top: "50%",
              transform: "translateY(-50%)",
              color: "var(--text-muted)",
            }}
          />
          <input
            type="text"
            placeholder={t("task.searchPlaceholder", "Rechercher par référence, responsable...")}
            value={searchQuery}
            onChange={(e) => setSearchQuery(e.target.value)}
            className="input-field"
            style={{
              width: "100%",
              padding: "0.75rem 1rem 0.75rem 2.5rem",
              borderRadius: "8px",
              border: "1px solid var(--border)",
            }}
          />
        </div>
        <select
          className="input-field"
          value={filterStatus}
          onChange={(e) => setFilterStatus(e.target.value)}
          style={{
            padding: "0.75rem 1rem",
            borderRadius: "8px",
            border: "1px solid var(--border)",
            background: "#FFF",
            minWidth: "200px",
          }}
        >
          <option value="all">{t("task.allStatuses", "Tous les statuts")}</option>
          {mode === "TACHE" ? (
            <>
              <option value="NOUVEAU">Nouveau</option>
              <option value="EN_COURS">En cours</option>
              <option value="EN_RELECTURE">En relecture</option>
              <option value="EN_APPROBATION">En approbation</option>
              <option value="APPROUVEE">Approuvée</option>
              <option value="A_CORRIGER">À corriger</option>
              <option value="BLOQUE">Bloqué</option>
              <option value="EN_ATTENTE">En attente</option>
            </>
          ) : (
            <>
              <option value="NOUVEAU">Nouveau</option>
              <option value="EN_COURS">En cours</option>
              
              <option value="TERMINE">Terminé</option>
              <option value="BLOQUE">Bloqué</option>
              <option value="EN_ATTENTE">En attente</option>
            </>
          )}
        </select>
      </div>
      <div className="table-wrapper">
        <table style={{ tableLayout: "fixed", width: "100%" }}>
          <thead>
            <tr>
              <th style={{ width: "110px", textAlign: "left", paddingLeft: "1.25rem" }}>{t("task.columns.id", "ID")}</th>
              <th style={{ width: "26%", textAlign: "left" }}>
                {mode === "MISSION" ? t("task.columns.missionFolder", "Dossier / Mission") : t("task.columns.missionId", "Mission")}
              </th>
              <th style={{ width: "22%", textAlign: "left" }}>{t("task.columns.assignedTo", "Assigné à")}</th>
              <th
                className="table-date-cell"
                style={{
                  width: "135px",
                  textAlign: "center",
                }}
              >
                {t("task.columns.dueDate", "Échéance")}
              </th>
              <th style={{ width: "120px", textAlign: "center" }}>{t("task.columns.status", "Statut")}</th>
              <th className="table-date-cell" style={{ width: "165px", textAlign: "center" }}>{t("task.columns.date", "Date de création")}</th>
              <th style={{ width: "80px", textAlign: "center" }}>{t("task.columns.actions", "Actions")}</th>
            </tr>
          </thead>
          <tbody>
            {tasks.map((t) => {
              const isExpired = (task) => {
                const d = task.echeance;
                if (!d) return false;
                if (
                  ["TERMINE", "TERMINE", "ARCHIVE", "ANNULEE"].includes(
                    task.status,
                  )
                )
                  return false;
                const today = new Date();
                today.setHours(0, 0, 0, 0);
                const date = new Date(d);
                date.setHours(0, 0, 0, 0);
                return date <= today;
              };
              return (
                <tr key={t.id} className={isExpired(t) ? "row-expired" : ""}>
                  <td style={{ textAlign: "left", paddingLeft: "1.25rem" }}>
                    <div
                      className="truncate-name"
                      style={{
                        color: "var(--text-main)",
                        margin: 0,
                        fontWeight: 400,
                        maxWidth: "100%",
                      }}
                      title={t.reference || t.id}
                    >
                      {t.reference || t.id.slice(0, 8)}
                    </div>
                  </td>
                  <td style={{ textAlign: "left" }}>
                    <div
                      className="truncate-name"
                      style={{
                        color: "var(--primary)",
                        fontWeight: 400,
                        margin: 0,
                        maxWidth: "100%",
                      }}
                      title={
                        mode === "MISSION"
                          ? t.dossier?.name || t.dossierId
                          : t.mission?.reference || t.missionId
                      }
                    >
                      {mode === "MISSION"
                        ? t.dossier?.name || t.dossierId
                        : t.mission?.reference || t.missionId}
                    </div>
                  </td>

                  <td style={{ textAlign: "left" }}>
                    <div
                      className="truncate-name"
                      style={{ margin: 0, maxWidth: "100%" }}
                      title={t.assignedTo?.name || "Non assigné"}
                    >
                      {t.assignedTo?.name || "Non assigné"}
                    </div>
                  </td>
                  <td className="table-date-cell" style={{ textAlign: "center" }}>
                    <span
                      style={{
                        color: t.echeance
                          ? "var(--text-main)"
                          : "var(--danger)",
                        fontWeight: 400,
                        margin: 0,
                      }}
                    >
                      {t.echeance
                        ? new Date(t.echeance).toLocaleDateString()
                        : "Aucune"}
                    </span>
                  </td>
                  <td style={{ textAlign: "center" }}>
                    {getStatusBadge(t.status)}
                  </td>
                  <td
                    className="table-date-cell"
                    style={{
                      textAlign: "center",
                      color: "var(--text-muted)",
                    }}
                  >
                    {formatDate(t.createdAt)}
                  </td>
                  <td>
                    <div
                      style={{
                        display: "flex",
                        flexDirection: "column",
                        gap: "0.25rem",
                        alignItems: "center",
                        justifyContent: "center",
                      }}
                    >
                      <button
                        type="button"
                        onClick={() => setConsultTask(t)}
                        style={{
                          background: "none",
                          border: "none",
                          cursor: "pointer",
                          color: "var(--primary)",
                          padding: "4px",
                        }}
                        title="Consulter la mission"
                      >
                        <Eye size={18} />
                      </button>
                      {(currentUser?.role === "Super-administrateur" ||
                        currentUser?.role?.name === "Super-administrateur" ||
                        currentUser?.role === "Responsable opérationnel" ||
                        currentUser?.role?.name ===
                          "Responsable opérationnel") && (
                        <button
                          type="button"
                          onClick={async () => {
                            if (
                              await window.customConfirm(
                                mode === "MISSION" 
                                  ? "Êtes-vous sûr de vouloir supprimer cette mission ?\n\nATTENTION : Cette action supprimera également, de façon hiérarchique, toutes les tâches associées vers la corbeille."
                                  : "Êtes-vous sûr de vouloir supprimer cette tâche ?\n\nElle sera déplacée vers la corbeille.",
                                mode === "MISSION" ? "Avertissement de suppression de la mission" : "Supprimer la tâche"
                              )
                            ) {
                              try {
                                const token =
                                  sessionStorage.getItem("adminToken");
                                const res = await fetch(
                                  new URL(
                                    getSafeApiUrl(
                                      `/api/crm/${mode === "MISSION" ? "tasks" : "taches"}/${encodeURIComponent(t.id)}`,
                                    ),
                                  ).toString(),
                                  {
                                    method: "DELETE",
                                    headers: {
                                      Authorization: `Bearer ${token}`,
                                    },
                                  },
                                );
                                if (res.ok) fetchData();
                              } catch (e) {
                                console.error("Erreur suppr mission:", e);
                              }
                            }
                          }}
                          style={{
                            background: "none",
                            border: "none",
                            cursor: "pointer",
                            color: "#EF4444",
                            padding: "4px",
                          }}
                          title="Supprimer la mission"
                        >
                          <Trash size={18} />
                        </button>
                      )}
                    </div>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>

      {totalPages >= 1 && (
        <div
          style={{
            display: "flex",
            justifyContent: "center",
            marginTop: "1.5rem",
            gap: "1rem",
            alignItems: "center",
          }}
        >
          <button
            type="button"
            disabled={page === 1}
            onClick={() => setPage((p) => Math.max(1, p - 1))}
            style={{
              padding: "0.5rem 1rem",
              borderRadius: "4px",
              border: "1px solid var(--border)",
              background: "#FFF",
              cursor: page === 1 ? "not-allowed" : "pointer",
            }}
          >
            Précédent
          </button>
          <span style={{  color: "var(--text-muted)" }}>
            Page {page} sur {totalPages}
          </span>
          <button
            type="button"
            disabled={page >= totalPages}
            onClick={() => setPage((p) => Math.min(totalPages, p + 1))}
            style={{
              padding: "0.5rem 1rem",
              borderRadius: "4px",
              border: "1px solid var(--border)",
              background: "#FFF",
              cursor: page >= totalPages ? "not-allowed" : "pointer",
            }}
          >
            Suivant
          </button>
        </div>
      )}

      {confirmingStatus && (
        <div
          style={{
            position: "fixed",
            top: 0,
            left: 0,
            width: "100%",
            height: "100%",
            backgroundColor: "rgba(0,0,0,0.5)",
            zIndex: 9999,
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
          }}
        >
          <div
            style={{
              background: "#FFF",
              padding: "2rem",
              borderRadius: "12px",
              boxShadow: "0 10px 25px rgba(0,0,0,0.2)",
              width: "100%",
              maxWidth: "400px",
              textAlign: "center",
            }}
          >
            <h3 style={{ marginTop: 0, color: "var(--primary-dark)", fontSize: "1.2rem", marginBottom: "0.5rem" }}>
              Confirmer l'enregistrement
            </h3>
            <p style={{ color: "var(--text-muted)", fontSize: "0.9rem", marginBottom: "1.5rem" }}>
              Vous allez enregistrer <strong>1 modification(s)</strong> sur ce(tte) {mode === "MISSION" ? "mission" : "tâche"}.
            </p>
            <div
              style={{
                background: "#F8FAFC",
                borderRadius: "8px",
                padding: "0.75rem 1rem",
                marginBottom: "1.5rem",
                fontSize: "0.9rem",
                color: "var(--text-main)",
                display: "flex",
                justifyContent: "space-between",
                alignItems: "center",
              }}
            >
              <span style={{ color: "var(--text-muted)", fontWeight: 500 }}>Statut</span>
              <span style={{ fontWeight: 600 }}>{TACHE_STATUS_LABELS[confirmingStatus] || confirmingStatus}</span>
            </div>
            <div style={{ display: "flex", gap: "1rem", justifyContent: "center" }}>
              <button
                type="button"
                className="btn btn-outline"
                onClick={() => setConfirmingStatus("")}
                style={{ padding: "0.5rem 1.5rem" }}
              >
                Annuler
              </button>
              <button
                type="button"
                className="btn btn-primary"
                onClick={() => {
                  handleWorkflowAction(consultTask.id, confirmingStatus);
                  setConfirmingStatus("");
                }}
                style={{ padding: "0.5rem 1.5rem" }}
              >
                Confirmer
              </button>
            </div>
          </div>
        </div>
      )}

      {renderCreateTaskModal()}

      <FilePreviewModal
        previewFile={previewFile}
        onClose={() => setPreviewFile(null)}
      />
    </div>
  );
};

export default GenericTaskPage;
</file>

