<file path="apps/vitrine/src/app/sitemap.ts">
import { MetadataRoute } from 'next';
import { generateSlug } from '@/utils/slug';
import { fetchPublishedNews } from '@/lib/cms';

export const revalidate = 1800; // Régénération toutes les 30 minutes

export default async function sitemap(): Promise<MetadataRoute.Sitemap> {
  const baseUrl = 'https://menuaconsulting.com';
  const now = new Date();

  // Extraction dynamique des publications CMS publiées
  const publications = await fetchPublishedNews();

  // Date de la dernière publication active ou date par défaut
  let latestPubDate = new Date('2026-10-08T09:00:00.000Z');
  if (publications.length > 0) {
    const dates = publications.map((p) =>
      p.updatedAt ? new Date(p.updatedAt).getTime() : (p.publishedAt ? new Date(p.publishedAt).getTime() : 0)
    );
    const maxTime = Math.max(...dates);
    if (maxTime > 0) {
      latestPubDate = new Date(maxTime);
    }
  }

  // Pages statiques avec dates réelles de modification significative
  type RouteEntry = {
    path: string;
    priority: number;
    freq: 'always' | 'hourly' | 'daily' | 'weekly' | 'monthly' | 'yearly' | 'never';
    lastMod: Date;
  };

  // Pages FR
  const frRoutes: RouteEntry[] = [
    { path: '/fr', priority: 1.0, freq: 'weekly', lastMod: latestPubDate },
    { path: '/fr/nous-connaitre', priority: 0.8, freq: 'monthly', lastMod: new Date('2026-10-07T12:00:00.000Z') },
    { path: '/fr/vos-besoins', priority: 0.8, freq: 'monthly', lastMod: new Date('2026-10-08T08:00:00.000Z') },
    { path: '/fr/nos-solutions', priority: 0.8, freq: 'monthly', lastMod: new Date('2026-10-08T08:00:00.000Z') },
    { path: '/fr/pourquoi-menua', priority: 0.8, freq: 'monthly', lastMod: new Date('2026-10-08T08:00:00.000Z') },
    { path: '/fr/actualites', priority: 0.9, freq: 'weekly', lastMod: latestPubDate },
    { path: '/fr/nous-rejoindre', priority: 0.7, freq: 'monthly', lastMod: new Date('2026-10-08T08:00:00.000Z') },
    { path: '/fr/nous-contacter', priority: 0.7, freq: 'monthly', lastMod: new Date('2026-10-07T10:00:00.000Z') },
    { path: '/fr/mentions-legales', priority: 0.3, freq: 'yearly', lastMod: new Date('2026-10-07T10:00:00.000Z') },
    { path: '/fr/politique-de-confidentialite', priority: 0.3, freq: 'yearly', lastMod: new Date('2026-10-08T08:00:00.000Z') },
  ];

  // Pages EN
  const enRoutes: RouteEntry[] = [
    { path: '/en', priority: 1.0, freq: 'weekly', lastMod: latestPubDate },
    { path: '/en/about-us', priority: 0.8, freq: 'monthly', lastMod: new Date('2026-10-07T12:00:00.000Z') },
    { path: '/en/your-needs', priority: 0.8, freq: 'monthly', lastMod: new Date('2026-10-08T08:00:00.000Z') },
    { path: '/en/our-solutions', priority: 0.8, freq: 'monthly', lastMod: new Date('2026-10-08T08:00:00.000Z') },
    { path: '/en/why-choose-us', priority: 0.8, freq: 'monthly', lastMod: new Date('2026-10-08T08:00:00.000Z') },
    { path: '/en/news', priority: 0.9, freq: 'weekly', lastMod: latestPubDate },
    { path: '/en/join-us', priority: 0.7, freq: 'monthly', lastMod: new Date('2026-10-08T08:00:00.000Z') },
    { path: '/en/contact-us', priority: 0.7, freq: 'monthly', lastMod: new Date('2026-10-07T10:00:00.000Z') },
    { path: '/en/legal-notices', priority: 0.3, freq: 'yearly', lastMod: new Date('2026-10-07T10:00:00.000Z') },
    { path: '/en/privacy-policy', priority: 0.3, freq: 'yearly', lastMod: new Date('2026-10-08T08:00:00.000Z') },
  ];

  const baseSitemap = [...frRoutes, ...enRoutes].map(({ path, priority, freq, lastMod }) => ({
    url: `${baseUrl}${path}`,
    lastModified: lastMod,
    changeFrequency: freq,
    priority,
  }));

  // URL dynamiques des articles publiés avec slug canonique et ID fallback
  const articleRoutes: MetadataRoute.Sitemap = [];
  for (const pub of publications) {
    const modDate = pub.updatedAt
      ? new Date(pub.updatedAt)
      : (pub.publishedAt ? new Date(pub.publishedAt) : now);

    const slugFr = generateSlug(pub.title, pub.id);
    const slugEn = generateSlug(pub.title_en || pub.title, pub.id);

    // URL FR
    articleRoutes.push({
      url: `${baseUrl}/fr/actualites/${slugFr}`,
      lastModified: modDate,
      changeFrequency: 'weekly' as const,
      priority: 0.8,
    });

    // URL EN
    articleRoutes.push({
      url: `${baseUrl}/en/news/${slugEn}`,
      lastModified: modDate,
      changeFrequency: 'weekly' as const,
      priority: 0.8,
    });
  }

  return [...baseSitemap, ...articleRoutes];
}
</file>

<file path="apps/admin/src/components/UserFormFields.jsx">
import React, { useState, useRef, useEffect } from "react";
import FormField from "./FormField";

const selectStyle = {
  width: "100%",
  padding: "0.5rem",
  borderRadius: "4px",
  border: "1px solid var(--border)",
  background: "white",
};

const UserFormFields = ({
  user,
  setUser,
  rolesList,
  polesList = [],
  isEdit,
  setSelectedFile,
}) => {
  const handleChange = (field) => (e) => {
    let value = e.target.value;
    if (field === "isBlocked") value = value === "Inactif";
    setUser({ ...user, [field]: value });
  };

  const [langDropdownOpen, setLangDropdownOpen] = useState(false);
  const langDropdownRef = useRef(null);

  useEffect(() => {
    const handleClickOutside = (event) => {
      if (langDropdownRef.current && !langDropdownRef.current.contains(event.target)) {
        setLangDropdownOpen(false);
      }
    };
    document.addEventListener("mousedown", handleClickOutside);
    return () => document.removeEventListener("mousedown", handleClickOutside);
  }, []);

  const LANGUAGES = [
    "Allemand", "Anglais", "Arabe", "Coréen", "Espagnol", "Français", 
    "Italien", "Japonais", "Mandarin", "Néerlandais", "Polonais", "Portugais"
  ];

  const selectedLanguages = user.langues ? user.langues.split(',').map(s => s.trim()).filter(Boolean) : [];

  const toggleLanguage = (lang) => {
    if (selectedLanguages.includes(lang)) {
      setUser({ ...user, langues: selectedLanguages.filter(l => l !== lang).join(', ') });
    } else {
      setUser({ ...user, langues: [...selectedLanguages, lang].join(', ') });
    }
  };

  return (
    <>
      <div
        style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: "1rem" }}
      >
        <FormField
          label="Nom complet"
          value={user.name}
          onChange={handleChange("name")}
          required={true}
        />
        <div>
          <label
            style={{
              display: "block",
              marginBottom: "0.25rem",
              fontWeight: 500,
            }}
          >
            Email <span style={{ color: "red" }}>*</span>
          </label>
          <input
            type="email"
            value={user.email || ""}
            onChange={handleChange("email")}
            required={true}
            style={{
              width: "100%",
              padding: "0.5rem",
              borderRadius: "4px",
              border: "1px solid var(--border)",
            }}
          />
        </div>
      </div>

      <div
        style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: "1rem" }}
      >
        <FormField
          label="Numéro de téléphone"
          type="tel"
          value={user.telephone}
          onChange={handleChange("telephone")}
          required={true}
        />
        <div>
          <label
            style={{
              display: "block",
              marginBottom: "0.25rem",
              fontWeight: 500,
            }}
          >
            Rôle <span style={{ color: "red" }}>*</span>
          </label>
          <select
            value={user.roleId || ""}
            onChange={handleChange("roleId")}
            style={selectStyle}
            required={true}
          >
            <option value="">Sélectionner un rôle...</option>
            {rolesList.map((r) => (
              <option key={r.id} value={r.id}>
                {r.name}
              </option>
            ))}
          </select>
        </div>
      </div>

      <div
        style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: "1rem" }}
      >
        <FormField
          label="Lieu de résidence"
          value={user.lieuResidence}
          onChange={handleChange("lieuResidence")}
          required={true}
        />
        <FormField
          label="Expérience clé"
          value={user.experienceCle}
          onChange={handleChange("experienceCle")}
          required={true}
        />
      </div>

      <div
        style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: "1rem" }}
      >
        <div ref={langDropdownRef} style={{ position: "relative" }}>
          <label
            style={{
              display: "block",
              marginBottom: "0.25rem",
              fontWeight: 500,
            }}
          >
            Langues <span style={{ color: "red" }}>*</span>
          </label>
          <div
            onClick={() => setLangDropdownOpen(!langDropdownOpen)}
            style={{
              width: "100%",
              padding: "0.5rem",
              borderRadius: "4px",
              border: "1px solid var(--border)",
              background: "white",
              cursor: "pointer",
              display: "flex",
              justifyContent: "space-between",
              alignItems: "center"
            }}
          >
            <span style={{ 
              whiteSpace: "nowrap", 
              overflow: "hidden", 
              textOverflow: "ellipsis", 
              color: selectedLanguages.length ? "inherit" : "var(--text-muted)" 
            }}>
              {selectedLanguages.length > 0 ? selectedLanguages.join(', ') : "Sélectionner des langues..."}
            </span>
            <span style={{ fontSize: "0.8rem", color: "var(--text-muted)" }}>▼</span>
          </div>
          
          {langDropdownOpen && (
            <div style={{
              position: "absolute",
              top: "100%",
              left: 0,
              right: 0,
              background: "white",
              border: "1px solid var(--border)",
              borderRadius: "4px",
              marginTop: "4px",
              maxHeight: "200px",
              overflowY: "auto",
              zIndex: 50,
              boxShadow: "0 4px 6px -1px rgba(0, 0, 0, 0.1)"
            }}>
              {LANGUAGES.map(lang => (
                <label 
                  key={lang} 
                  style={{
                    display: "flex",
                    alignItems: "center",
                    padding: "0.5rem",
                    cursor: "pointer",
                    background: selectedLanguages.includes(lang) ? "#f1f5f9" : "transparent"
                  }}
                >
                  <input
                    type="checkbox"
                    checked={selectedLanguages.includes(lang)}
                    onChange={() => toggleLanguage(lang)}
                    style={{ marginRight: "0.5rem" }}
                  />
                  {lang}
                </label>
              ))}
            </div>
          )}
        </div>
        <FormField
          label="Formations / Diplômes"
          value={user.formations}
          onChange={handleChange("formations")}
          inputProps={{ placeholder: "Ex: Master Finance" }}
        />
      </div>

      <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: "1rem", marginTop: "1rem" }}>
        <FormField
          label="Description profil"
          type="textarea"
          value={user.profile}
          onChange={handleChange("profile")}
        />
        <div>
          <label style={{ display: "block", marginBottom: "0.25rem", fontWeight: 500 }}>
            Statut <span style={{ color: "red" }}>*</span>
            {!isEdit && (
              <span style={{ color: "var(--text-muted)", fontSize: "0.75rem", marginLeft: "0.5rem" }}>
                (Invitation envoyée par défaut)
              </span>
            )}
          </label>
          <select
            value={user.status || "Invitation envoyée"}
            onChange={handleChange("status")}
            style={selectStyle}
          >
            <option value="Invitation envoyée">Invitation envoyée</option>
            <option value="Activation en attente">Activation en attente</option>
            <option value="Actif">Actif</option>
            <option value="Suspendu / Inactif">Suspendu / Inactif</option>
          </select>
        </div>
      </div>

      {/* ── Section V3 : Organisation & Fiche interne ─────────────────────────── */}
      <div style={{
        marginTop: "1.25rem",
        paddingTop: "1rem",
        borderTop: "1px solid var(--border)",
      }}>
        <p style={{ fontWeight: 600, fontSize: "0.78rem", color: "var(--text-muted)", textTransform: "uppercase", letterSpacing: "0.05em", marginBottom: "0.75rem" }}>
          Organisation &amp; Fiche interne
        </p>
        <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: "1rem" }}>
          {/* Pôle d'activité */}
          <div>
            <label style={{ display: "block", marginBottom: "0.25rem", fontWeight: 500 }}>
              Pôle d'activité
            </label>
            <select
              value={user.poleActivite || ""}
              onChange={handleChange("poleActivite")}
              style={selectStyle}
            >
              <option value="">— Aucun pôle —</option>
              {polesList.length > 0
                ? polesList.map((p) => (
                    <option key={p.id} value={p.name}>{p.name}</option>
                  ))
                : [
                    "Assurance",
                    "CGP / Patrimoine",
                    "Comptabilité / Gestion",
                    "Finance / Reporting",
                    "Risques / Conformité",
                    "Data / IT",
                    "Transversal",
                  ].map((n) => (
                    <option key={n} value={n}>{n}</option>
                  ))}
            </select>
          </div>
          {/* Matricule interne */}
          <div>
            <label style={{ display: "block", marginBottom: "0.25rem", fontWeight: 500 }}>
              Matricule interne
            </label>
            <input
              type="text"
              value={user.matricule || ""}
              onChange={handleChange("matricule")}
              placeholder="Ex: MC-2024-001"
              style={{ width: "100%", padding: "0.5rem", borderRadius: "4px", border: "1px solid var(--border)" }}
            />
          </div>
        </div>

        <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: "1rem", marginTop: "1rem" }}>
          {/* E-mail professionnel */}
          <div>
            <label style={{ display: "block", marginBottom: "0.25rem", fontWeight: 500 }}>
              E-mail professionnel (identifiant CRM)
            </label>
            <input
              type="email"
              value={user.emailPro || ""}
              onChange={handleChange("emailPro")}
              placeholder="prenom.nom@menuaconsulting.com"
              style={{ width: "100%", padding: "0.5rem", borderRadius: "4px", border: "1px solid var(--border)" }}
            />
          </div>
          {/* Fonction */}
          <div>
            <label style={{ display: "block", marginBottom: "0.25rem", fontWeight: 500 }}>
              Fonction / Intitulé de poste
            </label>
            <input
              type="text"
              value={user.fonction || ""}
              onChange={handleChange("fonction")}
              placeholder="Ex: Chargé(e) de back-office"
              style={{ width: "100%", padding: "0.5rem", borderRadius: "4px", border: "1px solid var(--border)" }}
            />
          </div>
        </div>
      </div>
    </>
  );
};

export default UserFormFields;
</file>

