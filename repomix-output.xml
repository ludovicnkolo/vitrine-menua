            ? "Prioritaire"
            : e.priorite && (e.priorite.toUpperCase() === "FAIBLE" || e.priorite.toUpperCase() === "BASSE")
            ? "Faible"
            : "Normal",
        createdAt: e.createdAt,
        dossierId: e.dossierId,
        missionId: e.missionId,
