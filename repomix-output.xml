                      ) => {
                        const isExpired = (msg) => {
                          const d = msg.dateRappel || msg.dateEntretien;
                          if (!d) return false;
                          if (
                            [
                              "TERMINE",
                              "ARCHIVE",
                              "CLASSE",
                              "GAGNE",
                              "RETENU",
                              "REFUSE",
                              "SANS_SUITE",
                            ].includes(msg.status)
                          )
                            return false;
                          const today = new Date();
                          today.setHours(0, 0, 0, 0);
                          const date = new Date(d);
                          date.setHours(0, 0, 0, 0);
                          return date <= today;
                        };
                        return (
                          <tr
                            key={m.id}
                            className={isExpired(m) ? "row-expired" : ""}
                          >
                            <td
                              style={{
                                fontWeight: 500,
                                color: "var(--text-muted)",
