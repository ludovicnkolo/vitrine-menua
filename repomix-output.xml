          : e.mission
            ? "Mission"
            : e.dossier
              ? "Dossier"
              : null,
        sourceRef:
          e.Tache?.reference ||
          e.mission?.reference ||
          e.dossier?.reference ||
          e.id,
      }));
    }

    sendPaginatedResponse(res, messages, total, page, limit);
  } catch (error) {
    console.error(error);
    res
      .status(500)
      .json({ error: "Erreur lors de la récupération des messages." });
  }
});

