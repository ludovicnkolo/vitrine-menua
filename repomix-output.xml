app.use("/api/crm", require("./routes/crm/clients"));
app.use("/api/crm", require("./routes/crm/dossiers"));
app.use("/api/crm", require("./routes/crm/audit"));
app.use("/api/crm", require("./routes/crm/missions"));
app.use("/api/crm", require("./routes/crm/taches"));
app.use("/api/crm", require("./routes/crm/documents"));
app.use("/api/crm", require("./routes/crm/messages"));
app.use("/api/crm", require("./routes/crm/dashboard"));
app.use("/api/crm", require("./routes/crm/notifications"));

// CMS routes (Publications, Offres)
const cmsRouter = require("./routes/cms");
app.use("/api/cms", cmsRouter);

// Poles d'activité routes
const polesRouter = require("./routes/poles");
app.use("/api/poles", polesRouter);

// Magic Links routes
const magicRouter = require("./routes/magic");
app.use("/api/magic", magicRouter);

// Get all dossiers
app.get("/api/dossiers", async (req, res) => {
  try {
    const dossiers = await prisma.dossier.findMany({
      include: { tasks: true },
    });
    res.json(dossiers);
  } catch (error) {
    console.error("Erreur récupération dossiers:", error);
    res.status(500).json({ error: "Server error" });
  }
});

const PORT = process.env.PORT || 4000;

app.listen(PORT, () => {
  console.log(`Backend server running on port ${PORT}`);

  // Auto-seed default roles and admin on startup
  try {
    const { execFileSync } = require("node:child_process");
    console.log(
      "Running seed_admin.js to ensure default roles and admin exist...",
    );
    execFileSync(process.execPath, ["seed_admin.js"], {
      cwd: path.join(__dirname, ".."),
      stdio: "inherit",
    });
  } catch (err) {
    console.error("Failed to run seed_admin.js on startup:", err);
  }

  // Lancement de l'export de la base de données toutes les 10 minutes
  try {
    const exportDatabase = require("../export_db");
    // On fait un premier export au démarrage (optionnel, mais utile)
    exportDatabase();

    const intervalMinStr = process.env.DB_BACKUP_INTERVAL_MINUTES || "10";
    const intervalMin = parseInt(intervalMinStr, 10);
    if (intervalMin > 0) {
      const intervalMs = intervalMin * 60 * 1000;
      setInterval(() => {
        const date = new Date().toLocaleString();
        console.log(`[${date}] Nouvelle exécution planifiée de l'export...`);
        exportDatabase();
      }, intervalMs);
      console.log(
        `Tâche d'export automatique de la base de données configurée (toutes les ${intervalMin} min).`,
      );
    } else {
      console.log(
        `Export automatique désactivé (DB_BACKUP_INTERVAL_MINUTES=${intervalMinStr}).`,
      );
    }
  } catch (err) {
    console.error("Erreur lors du paramétrage de l'export automatique :", err);
  }

  // Start Verifalia Cron
  try {
    const { startVerifaliaCron } = require("./services/verifaliaCron");
    startVerifaliaCron();
    console.log("Verifalia Cron started.");
  } catch (err) {
    console.error("Failed to start Verifalia Cron:", err);
  }

  // Start Storage Cleanup Cron (GED & CMS)
  try {
    const { startStorageCron } = require("./services/storageCron");
    startStorageCron();
    console.log("Storage Cron started.");
  } catch (err) {
    console.error("Failed to start Storage Cron:", err);
  }

  // Start Local S3 Sync Cron (Fallback uploads)
  try {
    const { startLocalUploadSyncCron } = require("./services/localUploadSync");
    startLocalUploadSyncCron();
    console.log("Local S3 Sync Cron started.");
  } catch (err) {
    console.error("Failed to start Local S3 Sync Cron:", err);
  }
});
</file>

<file path="apps/backend/seed_test_users.js">
/**
 * seed_test_users.js
 * Crée 2 utilisateurs de test par rôle (y compris Super-administrateur)
 * Crée 2 clients de test.
 * Mot de passe par défaut : TestMenua2026!
 *
 * Usage : node seed_test_users.js
 */

require('dotenv').config({ path: require('node:path').resolve(__dirname, '../../.env') });
const { PrismaClient } = require('@prisma/client');
const bcrypt = require('bcryptjs');

const prisma = new PrismaClient();

const PASSWORD = '123456t';

const USERS_TO_CREATE = [
  { roleName: 'Responsable opérationnel', prefix: 'resp.op.recette' },
  { roleName: 'Relecteur', prefix: 'relecteur.recette' },
  { roleName: 'Collaborateur', prefix: 'collaborateur.recette' },
  { roleName: 'Administrateur technique', prefix: 'admin.tech.recette' },
];

async function main() {
  console.log('=== SEED UTILISATEURS DE TEST ===');
  console.log(`Mot de passe commun : ${PASSWORD}\n`);

  const hashedPassword = await bcrypt.hash(PASSWORD, 10);

  // Récupère tous les rôles existants
  const roles = await prisma.role.findMany();
  const roleMap = {};
  roles.forEach(r => { roleMap[r.name] = r.id; });

  // Vérifie que tous les rôles nécessaires existent
  for (const group of USERS_TO_CREATE) {
    if (!roleMap[group.roleName] && group.roleName !== 'Super-administrateur') {
      console.error(`❌ Rôle introuvable en base : "${group.roleName}". Lance d'abord node seed_admin.js`);
      process.exit(1);
    }
  }

  // Génère les utilisateurs : 2 par rôle
  const usersToCreate = [];
  for (const group of USERS_TO_CREATE) {
    const roleId = roleMap[group.roleName];
    for (let i = 1; i <= 2; i++) {
      usersToCreate.push({
        email: `${group.prefix}${i}@menua.fr`,
        name: `${group.roleName} ${i}`,
        roleId: roleId,
        roleName: group.roleName,
      });
    }
  }

  // Upsert de chaque utilisateur
  for (const u of usersToCreate) {
    if (!u.roleId) continue; // Skip if role not found
    await prisma.utilisateur.upsert({
      where: { email: u.email },
      update: {
        password: hashedPassword,
        roleId: u.roleId,
        isBlocked: false,
      },
      create: {
        email: u.email,
        name: u.name,
        password: hashedPassword,
        roleId: u.roleId,
        telephone: '',
        lieuResidence: '',
        experienceCle: '',
        profile: '',
        isBlocked: false,
      },
    });
    console.log(`✓ [${u.roleName}] ${u.email}`);
  }

  console.log('\n=== SEED CLIENTS DE TEST ===');
  const clientsToCreate = [
    { email: 'contact@client-test-alpha.fr', name: 'CLIENT TEST ALPHA', type: 'SOCIETE', telephone: '0102030405', raisonSociale: 'ALPHA CORP' },
    { email: 'contact@client-test-beta.fr', name: 'CLIENT TEST BETA', type: 'SOCIETE', telephone: '0607080910', raisonSociale: 'BETA INC' }
  ];

  for (const c of clientsToCreate) {
    const existingClient = await prisma.client.findUnique({ where: { email: c.email } });
    if (existingClient) {
      await prisma.client.update({
        where: { email: c.email },
        data: {
          name: c.name,
          type: c.type,
          telephone: c.telephone,
          entreprise: {
            upsert: {
              create: { raisonSociale: c.raisonSociale },
              update: { raisonSociale: c.raisonSociale },
            },
          },
        },
      });
    } else {
      await prisma.client.create({
        data: {
          email: c.email,
          name: c.name,
          type: c.type,
          telephone: c.telephone,
          entreprise: {
            create: { raisonSociale: c.raisonSociale },
          },
        },
      });
    }
    console.log(`✓ [Client] ${c.name} (${c.email})`);
  }

  console.log(`\n=== ${usersToCreate.length} utilisateurs créés / mis à jour ===`);
  console.log(`=== ${clientsToCreate.length} clients créés / mis à jour ===`);
  console.log('\nRécapitulatif des comptes :');
  console.log('─────────────────────────────────────────────────────────');
  for (const u of usersToCreate) {
    console.log(`  ${u.email.padEnd(35)} → ${u.roleName}`);
  }
  console.log('─────────────────────────────────────────────────────────');
  console.log(`  Mot de passe : ${PASSWORD}`);
}

main()
  .then(() => process.exit(0))
  .catch(e => {
    console.error('Erreur :', e);
    process.exit(1);
  })
  .finally(() => prisma.$disconnect());
</file>

