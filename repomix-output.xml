const express = require("express");
const multer = require("multer");
const path = require("node:path");
const fs = require("node:fs");
const { Readable } = require("node:stream");
const crypto = require("node:crypto");
const { authenticateJWT } = require("../middlewares/auth");
const prisma = require("../prisma");
const { logAudit } = require("../utils/audit");

const router = express.Router();

const {
  uploadToS3,
  getPresignedUrl,
  purgeFromS3,
  verifyUploadIntegrity,
} = require("../services/s3Service");

// Utilisation du stockage en mémoire pour multer avant l'envoi vers S3
const storage = multer.memoryStorage();

const upload = multer({
  storage: storage,
  limits: {
    fileSize: 200 * 1024 * 1024, // 200MB — supporte les rapports, livrables et dossiers volumineux
    files: 1,
    fields: 10,
    fieldSize: 1024 * 1024,
  },
});

// Route POST : Upload sécurisé d'un fichier dans un bucket
router.post(
  "/upload",
  authenticateJWT,
  upload.single("file"),
  async (req, res) => {
    if (!req.file) {
      return res
        .status(400)
        .json({ success: false, error: "Aucun fichier uploadé." });
    }

    try {
      let bucket = req.body.bucket || "temp";
      if (
        bucket.includes("..") ||
        bucket.startsWith("/") ||
        bucket.startsWith("\\")
      ) {
        bucket = "temp";
      }

      const randomHex = crypto.randomBytes(8).toString("hex");
      const uniqueSuffix = Date.now() + "-" + randomHex;
      const safeOriginalName = req.file.originalname.replace(
        /[^a-zA-Z0-9.-]/g,
        "_",
      );
      const finalFilename = uniqueSuffix + "-" + safeOriginalName;
      const s3Key = `${bucket}/${finalFilename}`;

      // Upload to S3 directly from memory
      await uploadToS3(req.file.buffer, s3Key, req.file.mimetype);

      // Vérification d'intégrité post-upload (prévient tout NoSuchKey ultérieur)
      await verifyUploadIntegrity(s3Key);

      res.json({
        success: true,
        message: "Fichier sauvegardé avec succès sur S3.",
        fileData: {
          filename: finalFilename,
          bucket: bucket,
          path: s3Key, // Chemin relatif/S3 Key à sauvegarder en BDD
          size: req.file.size,
          mimetype: req.file.mimetype,
        },
      });
    } catch (error) {
      console.error("S3 Upload Error:", error);
      res
        .status(500)
        .json({ success: false, error: "Erreur lors de l'upload vers S3." });
    }
  },
);

// ─── ROUTE ATOMIQUE : Upload S3 + Rattachement BDD en une seule opération ──────
// Résout le bug de désynchronisation OVH ↔ BDD (P1).
// Si l'enregistrement en base échoue, le fichier est automatiquement supprimé
// de S3 (rollback), garantissant la cohérence entre OVH et le CRM.
router.post(
  "/upload-and-attach",
  authenticateJWT,
  upload.single("file"),
  async (req, res) => {
    if (!req.file) {
      return res
        .status(400)
        .json({ success: false, error: "Aucun fichier uploadé." });
    }

    const { dossierId, missionId, name } = req.body;
    if (!dossierId && !missionId) {
      return res
        .status(400)
        .json({
          success: false,
          error:
            "dossierId ou missionId est requis pour rattacher le document.",
        });
    }

    let bucket = req.body.bucket || "ged";
    if (
      bucket.includes("..") ||
      bucket.startsWith("/") ||
      bucket.startsWith("\\")
    ) {
      bucket = "ged";
    }

    const randomHex = crypto.randomBytes(8).toString("hex");
    const uniqueSuffix = Date.now() + "-" + randomHex;
    const safeOriginalName = req.file.originalname.replace(
      /[^a-zA-Z0-9.-]/g,
      "_",
    );
    const finalFilename = uniqueSuffix + "-" + safeOriginalName;
    const s3Key = `${bucket}/${finalFilename}`;

    // ── ÉTAPE 1 : Upload S3 + vérification d'intégrité ──────────────────────────
    try {
      await uploadToS3(req.file.buffer, s3Key, req.file.mimetype);
      // Contrôle post-upload : s'assurer que la clé est réellement accessible en OVH
      await verifyUploadIntegrity(s3Key);
    } catch (s3Error) {
      console.error({ event: "upload_s3_failed", error: s3Error.message });
      return res
        .status(502)
        .json({
          success: false,
          error: "Erreur lors de l'upload vers OVH. Aucune donnée enregistrée.",
        });
    }

    // ── ÉTAPE 2 : Enregistrement en BDD — avec rollback S3 si erreur ────────────
    let document;
    try {
      // Résolution de l'ID utilisateur (gestion du cas MASTER-ADMIN)
      let uploadedById = req.user?.id;
      if (uploadedById === "MASTER-ADMIN") {
        const masterUser =
          (await prisma.utilisateur.findUnique({
            where: { email: "contact@menuaconsulting.com" },
          })) || (await prisma.utilisateur.findFirst());
        uploadedById = masterUser?.id || uploadedById;
      }

      document = await prisma.document.create({
        data: {
          name: name || req.file.originalname,
          url: s3Key,
          uploadedById,
          ...(dossierId && { dossierId }),
          ...(missionId && { missionId }),
        },
        include: { uploadedBy: true },
      });
    } catch (dbError) {
      // ── ROLLBACK : Suppression du fichier S3 pour éviter un orphelin ───────────
      console.error({
        event: "db_insert_failed_rolling_back_s3",
        s3Key,
        error: dbError.message,
      });
      try {
        await purgeFromS3(s3Key);
        console.info({ event: "s3_rollback_success", s3Key });
      } catch (rollbackError) {
        // Le fichier reste dans S3 — logué pour nettoyage manuel / cron futur
        console.error({
          event: "s3_rollback_failed",
          s3Key,
          error: rollbackError.message,
        });
      }
      return res.status(500).json({
        success: false,
        error:
          "Erreur lors de l'enregistrement en base de données. Le fichier n'a pas été conservé.",
      });
    }

    // ── ÉTAPE 3 : Audit trail ────────────────────────────────────────────────────
    try {
      await logAudit(
        req.user?.id,
        "AJOUT_DOCUMENT",
        document.id,
        "DOCUMENT",
        `Document rattaché (atomique): ${document.name}`,
        document.dossierId || null,
      );
    } catch (auditError) {
      // L'audit n'est pas bloquant — on logue mais on ne fait pas échouer la requête
      console.warn({ event: "audit_log_failed", error: auditError.message });
    }

    return res.status(201).json({
      success: true,
      message: "Document uploadé et rattaché avec succès.",
      document,
    });
  },
);

// Route GET : Téléchargement sécurisé via le backend (Redirection S3 Presigned URL)
router.get("/download/:bucket/:filename", authenticateJWT, async (req, res) => {
  const { bucket, filename } = req.params;

  if (
    bucket.includes("..") ||
    filename.includes("..") ||
    bucket.includes("/")
  ) {
    return res.status(403).json({ success: false, error: "Accès interdit." });
  }

  const s3Key = `${bucket}/${filename}`;

  try {
    const url = await getPresignedUrl(s3Key, 3600, false); // false = force download via content-disposition
    res.redirect(url);
  } catch (error) {
    console.error("Erreur génération URL S3:", error);
    res
      .status(500)
      .json({
        success: false,
        error: "Erreur lors de la génération du lien de téléchargement.",
      });
  }
});

// Route GET : Consultation inline (Affichage navigateur via Presigned URL)
// Le wildcard (*) permet de capturer des clés S3 multi-niveaux comme :
// menua-ged-prod/dossiers/dos-05/fichier.pdf
router.get("/view/*", authenticateJWT, async (req, res) => {
  // req.params[0] contient tout ce qui suit /view/
  const fullPath = decodeURIComponent(req.params[0] || "");
  const slashIndex = fullPath.indexOf("/");

  if (slashIndex === -1) {
    return res.status(400).json({ success: false, error: "Chemin S3 invalide." });
  }

  const bucket = fullPath.substring(0, slashIndex);
  const filename = fullPath.substring(slashIndex + 1);

  if (bucket.includes("..") || filename.includes("..")) {
    return res.status(403).json({ success: false, error: "Accès interdit." });
  }

  const s3Key = `${bucket}/${filename}`;

  try {
    const url = await getPresignedUrl(s3Key, 3600, true); // true = inline display

    if (req.query.stream === "true") {
      // Proxy le fichier depuis S3 via le backend pour éviter le blocage CORS
      // S3 OVH ne retourne pas Access-Control-Allow-Origin sur les URLs présignées
      const fetchResponse = await fetch(url);
      if (!fetchResponse.ok) {
        console.error(`[S3] ${fetchResponse.status} pour la clé : ${s3Key}`);
        return res
          .status(fetchResponse.status)
          .json({
            success: false,
            error: `Fichier introuvable (S3 ${fetchResponse.status}).`,
          });
      }
      let contentType = fetchResponse.headers.get("content-type");
      if (!contentType || contentType === "application/octet-stream" || contentType === "binary/octet-stream") {
        if (/\.jpe?g$/i.test(filename)) contentType = "image/jpeg";
        else if (/\.png$/i.test(filename)) contentType = "image/png";
        else if (/\.gif$/i.test(filename)) contentType = "image/gif";
        else if (/\.webp$/i.test(filename)) contentType = "image/webp";
        else if (/\.svg$/i.test(filename)) contentType = "image/svg+xml";
        else if (/\.pdf$/i.test(filename)) contentType = "application/pdf";
        else contentType = "application/octet-stream";
      }
      res.setHeader("Content-Type", contentType);
      res.setHeader("Cache-Control", "private, max-age=3600");
      const arrayBuffer = await fetchResponse.arrayBuffer();
      return res.end(Buffer.from(arrayBuffer));
    }

    // Sans stream=true : redirection simple vers S3 (pour téléchargement direct)
    res.redirect(url);
  } catch (error) {
    console.error("Erreur génération URL S3 inline:", error);
    res
      .status(500)
      .json({ success: false, error: "Erreur de lecture du fichier." });
  }
});
// ─── P3 : REMPLACEMENT DE DOCUMENT (PHYSIQUE) ────────────────────────────────
// Remplace le fichier S3 d'un document existant, en conservant son ID en base.
// Si l'upload réussit mais la BDD échoue, le nouveau fichier S3 est supprimé (rollback).
// Si tout réussit, l'ancien fichier S3 est supprimé pour libérer de l'espace.
router.post(
  "/replace/:id",
  authenticateJWT,
  upload.single("file"),
  async (req, res) => {
    if (!req.file) {
      return res
        .status(400)
        .json({ success: false, error: "Aucun fichier uploadé." });
    }

    try {
      const docId = req.params.id;
      const document = await prisma.document.findUnique({
        where: { id: docId },
      });
      if (!document) {
        return res
          .status(404)
          .json({ success: false, error: "Document introuvable." });
      }
      if (document.isDeleted) {
        return res
          .status(409)
          .json({
            success: false,
            error:
              "Ce document est dans la corbeille. Restaurez-le pour le modifier.",
          });
      }

      const oldS3Key = document.url;
      let bucket = oldS3Key.split("/")[0] || "ged";

      const randomHex = crypto.randomBytes(8).toString("hex");
      const uniqueSuffix = Date.now() + "-" + randomHex;
      const safeOriginalName = req.file.originalname.replace(
        /[^a-zA-Z0-9.-]/g,
        "_",
      );
      const finalFilename = uniqueSuffix + "-" + safeOriginalName;
      const newS3Key = `${bucket}/${finalFilename}`;

      // ── ÉTAPE 1 : Upload nouveau fichier S3 + vérification d'intégrité
      try {
        await uploadToS3(req.file.buffer, newS3Key, req.file.mimetype);
        // Contrôle post-upload : garantir que la nouvelle clé est accessible avant de modifier la BDD
        await verifyUploadIntegrity(newS3Key);
      } catch (s3Error) {
        console.error({
          event: "replace_s3_upload_failed",
          error: s3Error.message,
        });
        return res
          .status(502)
          .json({
            success: false,
            error: "Erreur lors de l'upload du nouveau fichier vers OVH.",
          });
      }

      // ── ÉTAPE 2 : Mise à jour BDD (avec rollback)
      let updatedDoc;
      try {
        updatedDoc = await prisma.document.update({
          where: { id: docId },
          data: {
            url: newS3Key,
            // Optionnel: on peut mettre à jour le nom si le client le souhaite,
            // mais généralement on garde le nom logique ou on prend le nouveau originalname.
            // Ici on met à jour le nom si on le reçoit, sinon le nom d'origine du fichier.
            name: req.body.name || req.file.originalname,
          },
          include: { uploadedBy: true },
        });
      } catch (dbError) {
        // ── ROLLBACK : Suppression du nouveau fichier S3
        console.error({
          event: "replace_db_update_failed_rolling_back_s3",
          newS3Key,
          error: dbError.message,
        });
        try {
          await purgeFromS3(newS3Key);
        } catch (rollbackError) { }
        return res
          .status(500)
          .json({
            success: false,
            error: "Erreur lors de la mise à jour en base de données.",
          });
      }

      // ── ÉTAPE 3 : Suppression de l'ANCIEN fichier S3
      try {
        await purgeFromS3(oldS3Key);
      } catch (cleanupError) {
        console.warn({
          event: "replace_old_s3_cleanup_failed",
          oldS3Key,
          error: cleanupError.message,
        });
        // Non bloquant. Le cron P4 finira par nettoyer les orphelins si nécessaire,
        // bien que cet ancien fichier n'ait plus de ref en BDD.
      }

      // Audit trail
      try {
        await logAudit(
          req.user?.id,
          "MODIFICATION_DOCUMENT",
          document.id,
          "DOCUMENT",
          `Document remplacé: ${document.name} -> ${updatedDoc.name}`,
          document.dossierId || null,
        );
      } catch (e) { }

      return res.json({
        success: true,
        message: "Fichier remplacé avec succès.",
        document: updatedDoc,
      });
    } catch (error) {
      console.error("Replace Error:", error);
      res
        .status(500)
        .json({
          success: false,
          error: "Erreur serveur lors du remplacement.",
        });
    }
  },
);

module.exports = router;
</file>

<file path="apps/backend/src/routes/forms.js">
const express = require("express");
const multer = require("multer");
const crypto = require("node:crypto");
const nodemailer = require("nodemailer");
const xss = require("xss");
const rateLimit = require("express-rate-limit");
const dns = require("dns").promises;
const fs = require("node:fs");
const path = require("node:path");
const { PrismaClient } = require("@prisma/client");
const { sendResponse } = require("../utils/responses");
const { transporter } = require("../utils/mailer");
const prisma = new PrismaClient();

const router = express.Router();

const { verifyTurnstile } = require("../services/turnstile");
const verifalia = require("../services/verifalia");
const {
  sendAutoReply,
  sendAdminNotification,
} = require("../services/emailService");

// ── Paramètres des formulaires (blacklist email/domain, activation) ──────────
const FORM_SETTINGS_PATH = path.join(__dirname, "../config/form_settings.json");

const getFormSettings = () => {
  try {
    const raw = fs.readFileSync(FORM_SETTINGS_PATH, "utf-8");
    return JSON.parse(raw);
  } catch (e) {
    console.error("Impossible de lire form_settings.json", e.message);
    return {
      blacklistedEmails: [],
      contactFormEnabled: true,
      recrutementFormEnabled: true,
    };
  }
};

const isEmailBlacklisted = (email, settings) => {
  const normalizedEmail = (email || "").toLowerCase().trim();
  if (
    settings.blacklistedEmails
      ?.map((e) => e.toLowerCase())
      .includes(normalizedEmail)
  )
    return true;
  return false;
};

const upload = multer({
  storage: multer.memoryStorage(),
  limits: { fileSize: Number.parseInt(process.env.UPLOAD_MAX_FILE_SIZE) },
});

// Strict rate limiting specifically for forms
const formLimiter = rateLimit({
  windowMs: Number.parseInt(process.env.RATE_LIMIT_FORM_WINDOW_MS),
  max: Number.parseInt(process.env.RATE_LIMIT_FORM_MAX),
  message: {
    success: false,
    error: "Trop de soumissions, veuillez réessayer plus tard.",
  },
});

router.use(formLimiter);

const sanitizeInput = (data) => {
  if (typeof data === "string") return xss(data);
  if (Array.isArray(data)) return data.map(sanitizeInput);
  if (typeof data === "object" && data !== null) {
    const sanitized = {};
    for (const key in data) {
      sanitized[key] = sanitizeInput(data[key]);
    }
    return sanitized;
  }
  return data;
};

// Email templates are now in emailService.js

// ── Récupérer le statut public des formulaires (sans blacklist) ──────────
router.get("/status", (req, res) => {
  const settings = getFormSettings();
  res.json({
    success: true,
    data: {
      contactFormEnabled: settings.contactFormEnabled,
      recrutementFormEnabled: settings.recrutementFormEnabled,
    },
  });
});

router.post("/contact", upload.none(), async (req, res) => {
  try {
    const sanitizedBody = sanitizeInput(req.body);
    const {
      clientType,
      company,
      firstName,
      lastName,
      email,
      phone,
      description,
      needs,
      "cf-turnstile-response": turnstileToken,
    } = sanitizedBody;

    const fullName = `${firstName || ""} ${lastName || ""}`.trim();
    const senderEmail = email;
    const lang = req.query.lang || req.body.lang || "fr";

    const settings = getFormSettings();
    if (!settings.contactFormEnabled) {
      return sendResponse(res, 403, "ERROR_FORM_DISABLED", lang); // Need to define this or use a generic error
    }

    if (!senderEmail) {
      return sendResponse(res, 400, "ERROR_EMAIL_REQUIRED", lang);
    }

    if (isEmailBlacklisted(senderEmail, settings)) {
      return sendResponse(res, 403, "ERROR_FORBIDDEN", lang); // Use a generic forbidden or specifically handle it. Let's return 403 with generic error or generic forbidden. We'll send a vague error to not confirm blacklist to spammer.
    }

    const ip = req.headers["x-forwarded-for"] || req.socket.remoteAddress;
    const isTurnstileValid = await verifyTurnstile(turnstileToken, ip);
    if (!isTurnstileValid) {
      return sendResponse(res, 400, "ERROR_INVALID_CAPTCHA", lang);
    }

    // Validation des champs obligatoires (*)
    if (!firstName || !lastName) {
      return sendResponse(res, 400, "ERROR_REQUIRED_FIELDS", lang);
    }
    if (!description) {
      return sendResponse(res, 400, "ERROR_REQUIRED_FIELDS", lang);
    }
    if (clientType === "company" && !company) {
      return sendResponse(res, 400, "ERROR_REQUIRED_FIELDS", lang);
    }

    let parsedNeeds = [];
    if (Array.isArray(needs)) {
      parsedNeeds = needs;
    } else if (needs) {
      parsedNeeds = [needs];
    }

    const typeText =
      clientType === "company" ? "Entreprise / Organisation" : "Particulier";
    const companyHtml =
      clientType === "company"
        ? `<strong>Société</strong> : <span>${company}</span><br/>`
        : "";
    const needsHtml =
      parsedNeeds.length > 0
        ? `<ul>${parsedNeeds.map((n) => `<li>${n}</li>`).join("")}</ul>`
        : "<em>Aucun besoin spécifique coché</em>";

    const contentHTML = `
      <div style="margin-bottom: 20px;">
        <strong>Type de client</strong> : <span>${typeText}</span><br/>
        ${companyHtml}
        <strong>Nom complet</strong> : <span>${fullName}</span><br/>
        <strong>Email</strong> : <span>${senderEmail}</span><br/>
        <strong>Téléphone</strong> : <span>${phone || ""}</span>
      </div>
      <strong>Besoins identifiés</strong> : <div>${needsHtml}</div><br/>
      <strong>Description du besoin</strong> : <div>
      ${description ? description.replaceAll("\n", "<br/>") : ""}
      </div>
    `;

    // --- IMMEDIATE VERIFALIA CHECK ---
    const verification = await verifalia.verifyEmailImmediate(senderEmail);
    if (verification.status === "INVALID") {
      return sendResponse(res, 400, "ERROR_EMAIL_INVALID", lang);
    }

    // Si VALID => on procède normalement (NOUVEAU) et on envoie les emails.
    // Si DEFERRED => on enregistre avec verifaliaStatus A_VERIFIER pour que le cron prenne le relais.
    const isDeferred = verification.status === "DEFERRED";
    const formStatus = "NOUVEAU";

    // Enregistrement dans le CRM
    let formulaireRecord;
    try {
      formulaireRecord = await prisma.formulaire.create({
        data: {
          formulaireId: crypto.randomUUID(),
          type: "CONTACT",
          statusSubmitter: clientType === "company" ? "SOCIETE" : "PARTICULIER",
          nomPrenom: fullName,
          email: senderEmail,
          telephone: phone || null,
          description: description || null,
          raisonSocial: company || null,
          objet: "Demande de contact",
          bodyHtml: contentHTML,
          isAnonyme: true,
          status: formStatus,
          verifaliaJobId: isDeferred ? verification.jobId : null,
          verifaliaStatus:
            verification.status === "VALID"
              ? "COMPLETED_VALID"
              : verification.reason || "A_VERIFIER",
          contact: {
            create: {
              typeBesoin: parsedNeeds.join(", "),
              pieceJointe: null,
            },
          },
        },
        include: { contact: true },
      });
    } catch (dbError) {
      console.error({
        event: "db_save_error_contact",
        error: dbError.message || dbError,
      });
      return sendResponse(res, 500, "ERROR_INTERNAL_SERVER", lang);
    }

    // Si on a pu valider l'email immédiatement, on envoie les notifications tout de suite
    if (!isDeferred && formulaireRecord) {
      Promise.all([
        sendAutoReply(senderEmail, lang).catch((e) =>
          console.error({ event: "contact_autoreply_error", error: e.message }),
        ),
        sendAdminNotification(formulaireRecord).catch((e) =>
          console.error({
            event: "contact_adminnotif_error",
            error: e.message,
          }),
        ),
      ]);
    } else if (formulaireRecord) {
      // Pour les cas différés / à vérifier : notifier l'administrateur interne, mais PAS d'envoi externe
      sendAdminNotification(formulaireRecord).catch((e) =>
        console.error({ event: "contact_adminnotif_error", error: e.message }),
      );
    }

    return sendResponse(res, 200, "SUCCESS_CONTACT", lang);
  } catch (error) {
    const lang = req.query.lang || req.body.lang || "fr";
    console.error({
      event: "contact_form_error",
      error: error.message || error,
    });
    return sendResponse(res, 500, "ERROR_INTERNAL_SERVER", lang);
  }
});

router.post("/join", upload.none(), async (req, res) => {
  try {
    const sanitizedBody = sanitizeInput(req.body);
    const {
      lastName,
      firstName,
      email,
      phone,
      experience,
      languages,
      location,
      availability,
      linkedin,
      message,
      skills,
      otherSkill,
      "cf-turnstile-response": turnstileToken,
    } = sanitizedBody;
    const lang = req.query.lang || req.body.lang || "fr";

    const settings = getFormSettings();
    if (!settings.recrutementFormEnabled) {
      return sendResponse(res, 403, "ERROR_FORM_DISABLED", lang);
    }

    if (!email) {
      return sendResponse(res, 400, "ERROR_EMAIL_REQUIRED", lang);
    }

    if (isEmailBlacklisted(email, settings)) {
      return sendResponse(res, 403, "ERROR_FORBIDDEN", lang);
    }

    const ip = req.headers["x-forwarded-for"] || req.socket.remoteAddress;
    const isTurnstileValid = await verifyTurnstile(turnstileToken, ip);
    if (!isTurnstileValid) {
