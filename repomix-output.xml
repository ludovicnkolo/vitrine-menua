<file path="apps/backend/src/middlewares/auth.js">
const jwt = require("jsonwebtoken");
const prisma = require("../prisma");
const JWT_SECRET = process.env.JWT_SECRET;

// ─── HELPERS DE RÔLE CENTRALISÉS ─────────────────────────────────────────────
// Seuls ces rôles voient les éléments BLOQUÉS et peuvent les créer
const SUPER_ADMIN_ROLES = ["Super-administrateur"];

// Ces rôles ont accès admin complet au CRM
const ADMIN_ROLES = ["Super-administrateur"];

// Ces rôles peuvent créer des dossiers et des missions
const MANAGER_ROLES = ["Super-administrateur", "Responsable opérationnel"];

// Helpers booléens
const isSuperAdmin = (role) => SUPER_ADMIN_ROLES.includes(role);
const isAdmin = (role) => ADMIN_ROLES.includes(role);
const isManager = (role) => MANAGER_ROLES.includes(role);

// ─── MIDDLEWARE AUTHENTIFICATION ──────────────────────────────────────────────
const authenticateJWT = (req, res, next) => {
  const authHeader = req.headers.authorization;
  let token = null;

  if (authHeader && authHeader.startsWith("Bearer ")) {
    const raw = authHeader.split(" ")[1];
    if (raw && raw !== "null" && raw !== "undefined" && raw !== "") {
      token = raw;
    }
  }

  if (!token && req.cookies && req.cookies.token) {
    token = req.cookies.token;
  } else if (!token && req.query && req.query.token) {
    token = req.query.token;
  }

  if (token) {
    jwt.verify(token, JWT_SECRET, async (err, user) => {
      if (err) {
        return res.status(401).json({ error: "Token invalide ou expiré." });
      }

      if (user.id === "MASTER-ADMIN") {
        req.user = { ...user, role: "Super-administrateur" };
        return next();
      }

      try {
        const dbUser = await prisma.utilisateur.findUnique({
          where: { id: user.id },
          include: { role: true },
        });
        if (!dbUser) {
          return res
            .status(401)
            .json({
              error:
                "Utilisateur introuvable en base. Veuillez vous reconnecter.",
              action: "FORCE_LOGOUT",
            });
        }
        if (dbUser.isBlocked) {
          return res
            .status(401)
            .json({
              error: "Votre compte a été désactivé par l'administrateur.",
              action: "FORCE_LOGOUT",
            });
        }
        
        // Validation de session: si le mot de passe a changé, la signature change
        if (user.sessionSig !== undefined) {
          const currentSig = dbUser.password ? dbUser.password.substring(dbUser.password.length - 10) : "";
          if (user.sessionSig !== currentSig) {
            return res
              .status(401)
              .json({
                error: "Session expirée suite à une modification du mot de passe. Veuillez vous reconnecter.",
                action: "FORCE_LOGOUT",
              });
          }
        }
        req.user = {
          ...user,
          role: dbUser.role?.name || user.role || "Collaborateur",
          name: dbUser.name,
          email: dbUser.email,
        };
      } catch (dbError) {
        console.error("[AUTH DB ERROR]", dbError?.message || dbError);
        return res
          .status(500)
          .json({
            error: "Erreur de vérification utilisateur: service indisponible.",
          });
      }

      next();
    });
  } else {
    res.status(401).json({ error: "Accès non autorisé. Token manquant." });
  }
};

// ─── MIDDLEWARE VÉRIFICATION DES RÔLES ───────────────────────────────────────
const requireRoles = (...allowedRoles) => {
  return (req, res, next) => {
    if (!req.user) {
      return res.status(401).json({ error: "Non authentifié." });
    }
    // Super-Admin a toujours accès complet
    const isSuperAdm = req.user.role === "Super-administrateur";
    if (isSuperAdm || req.user.id === "MASTER-ADMIN") {
      return next();
    }
    if (allowedRoles.includes(req.user.role)) {
      return next();
    }
    return res
      .status(403)
      .json({ error: "Accès interdit : privilèges insuffisants." });
  };
};

module.exports = {
  authenticateJWT,
  requireRoles,
  JWT_SECRET,
  isSuperAdmin,
  isAdmin,
  isManager,
  SUPER_ADMIN_ROLES,
  ADMIN_ROLES,
  MANAGER_ROLES,
};
</file>

<file path="apps/backend/src/routes/magic.js">
const express = require("express");
const { PrismaClient } = require("@prisma/client");
const { authenticateJWT } = require("../middlewares/auth");
const multer = require("multer");
const { uploadToS3, getPresignedUrl } = require("../services/s3Service");
const { randomUUID } = require("crypto");
const path = require("path");

const router = express.Router();
const prisma = new PrismaClient();
const { logAudit } = require("../utils/audit");
const { notify } = require("../utils/notify");
const { transporter } = require("../utils/mailer");

// Multer in memory for S3 upload
const upload = multer({
  storage: multer.memoryStorage(),
  limits: { fileSize: 200 * 1024 * 1024 }, // 200MB max per file
});

// ─── ADMIN ROUTES ────────────────────────────────────────────────────────────

// Create a new Magic Link
router.post("/generate", authenticateJWT, async (req, res) => {
  try {
    const { dossierId, type, expiresInDays = 7, note, attachedDocumentIds } = req.body;

    if (!dossierId || !type) {
      return res
        .status(400)
        .json({ success: false, error: "dossierId et type requis." });
    }

    const expiresAt = new Date();
    expiresAt.setDate(expiresAt.getDate() + parseInt(expiresInDays, 10));

    const magicLink = await prisma.lienMagique.create({
      data: {
        type,
        dossierId,
        createdBy: req.user.id,
        expiresAt,
        note: note || null,
        attachedDocumentIds: attachedDocumentIds
          ? JSON.stringify(attachedDocumentIds)
          : null,
      },
    });

    await logAudit(
      req.user.id,
      "CREATION_LIEN_MAGIQUE",
      magicLink.id,
      "MAGIC_LINK",
      `Lien magique (${type}) généré pour le dossier`,
      dossierId,
    );

    res.json({ success: true, data: magicLink });
  } catch (error) {
    console.error("Erreur génération lien magique:", error);
    res.status(500).json({ success: false, error: "Erreur serveur." });
  }
});

// List Magic Links for a Dossier
router.get("/dossier/:dossierId", authenticateJWT, async (req, res) => {
  try {
    const { dossierId } = req.params;
    const links = await prisma.lienMagique.findMany({
      where: { dossierId },
      orderBy: { createdAt: "desc" },
    });
    res.json({ success: true, data: links });
  } catch (error) {
    console.error("Erreur listing liens magiques:", error);
    res.status(500).json({ success: false, error: "Erreur serveur." });
  }
});

// Revoke a Magic Link
router.delete("/:id", authenticateJWT, async (req, res) => {
  try {
    const link = await prisma.lienMagique.findUnique({
      where: { id: req.params.id },
    });
    if (link) {
      await prisma.lienMagique.delete({ where: { id: req.params.id } });
      await logAudit(
        req.user.id,
        "REVOCATION_LIEN_MAGIQUE",
        req.params.id,
        "MAGIC_LINK",
        `Lien magique révoqué`,
        link.dossierId,
      );
    }
    res.json({ success: true });
  } catch (error) {
    console.error("Erreur révocation lien magique:", error);
    res.status(500).json({ success: false, error: "Erreur serveur." });
  }
});

// ─── PUBLIC ROUTES (CLIENT FACING) ──────────────────────────────────────────

// Verify token and get info (Dossier name, allowed actions)
router.get("/verify/:token", async (req, res) => {
  try {
    const { token } = req.params;
    const magicLink = await prisma.lienMagique.findUnique({
      where: { token },
      include: {
        dossier: {
          include: { client: true, documents: true },
        },
      },
    });

    if (!magicLink) {
      return res
        .status(404)
        .json({ success: false, error: "Lien invalide ou introuvable." });
    }

    if (new Date() > new Date(magicLink.expiresAt)) {
      return res
        .status(403)
        .json({
          success: false,
          error:
            "Ce lien a expiré. Veuillez contacter votre conseiller pour obtenir un nouveau lien.",
        });
    }

    // ── Vérification du statut du dossier ────────────────────────────────────
    const dossierStatus = magicLink.dossier?.status;
    if (
      ["BLOQUE", "ARCHIVE", "CORBEILLE", "CLOTURE", "ANNULEE"].includes(
        dossierStatus,
      )
    ) {
      const statusMessages = {
        BLOQUE:
          "Ce lien est temporairement suspendu. Veuillez contacter votre conseiller.",
        ARCHIVE:
          "Ce dossier est archivé. Les échanges de documents ne sont plus possibles.",
        CORBEILLE: "Ce dossier n'est plus disponible.",
        CLOTURE:
          "Ce dossier est clôturé. Les échanges de documents ne sont plus possibles.",
        ANNULEE: "Ce dossier a été annulé.",
      };
      return res
        .status(403)
        .json({
          success: false,
          error:
            statusMessages[dossierStatus] || "Ce dossier n'est plus actif.",
        });
    }

    // Only expose safe information
    const data = {
      id: magicLink.id,
      type: magicLink.type,
      note: magicLink.note || null,
      dossierRef: magicLink.dossier.reference,
      clientName:
        magicLink.dossier.client?.raisonSocial ||
        magicLink.dossier.client?.nom ||
        "Client",
      documents: [],
    };

    // If LIVRAISON, generate presigned URLs for documents attached to this link only
    if (magicLink.type === "LIVRAISON") {
      let allowedIds = null;
      if (magicLink.attachedDocumentIds) {
        try {
          allowedIds = JSON.parse(magicLink.attachedDocumentIds);
        } catch (_) {}
      }

      const activeDocs = magicLink.dossier.documents.filter((d) => {
        if (d.isDeleted) return false;
        if (allowedIds && allowedIds.length > 0) {
          return allowedIds.includes(d.id);
        }
        // Fallback si pas d'IDs enregistrés : ne rien montrer
        return false;
      });
      const docsWithUrls = await Promise.all(
        activeDocs.map(async (doc) => {
          // If it's an S3 object (no path traversal ./), we generate a presigned URL
          let downloadUrl = doc.url;
          if (!doc.url.startsWith("/") && !doc.url.startsWith("http")) {
            downloadUrl = await getPresignedUrl(doc.url, 3600, false); // force download
          }
          return {
            id: doc.id,
            name: doc.name,
            type: doc.type,
            downloadUrl,
          };
        }),
      );
      data.documents = docsWithUrls;
    }

    // ── Traçabilité : log l'accès au lien ───────────────────────────────────
    try {
      await logAudit(
        null,
        "ACCES_LIEN_MAGIQUE",
        magicLink.id,
        "MAGIC_LINK",
        `Accès au lien magique (${magicLink.type}) — IP: ${req.ip || "inconnue"}`,
        magicLink.dossierId,
      );
    } catch (_) {}

    res.json({ success: true, data });
  } catch (error) {
    console.error("Erreur vérification lien magique:", error);
    res.status(500).json({ success: false, error: "Erreur serveur." });
  }
});

// ─── Log download via Magic Link ─────────────────────────────────────────────
router.post("/log-download/:token", async (req, res) => {
  try {
    const { token } = req.params;
    const { documentName } = req.body;
    const magicLink = await prisma.lienMagique.findUnique({ where: { token } });
    if (!magicLink) return res.status(404).json({ success: false });

    await logAudit(
      null,
      "TELECHARGEMENT_DOCUMENT_MAGIQUE",
      magicLink.id,
      "MAGIC_LINK",
      `Téléchargement via lien magique : "${documentName || "inconnu"}" — IP: ${req.ip || "inconnue"}`,
      magicLink.dossierId,
    );
    res.json({ success: true });
  } catch (error) {
    console.error("Erreur log téléchargement:", error);
    res.status(500).json({ success: false });
  }
});

// ─── Send Magic Link by email ─────────────────────────────────────────────────
router.post("/send-email/:id", authenticateJWT, async (req, res) => {
  try {
    const { id } = req.params;
    const { recipientEmail, magicUrl } = req.body;

    if (!recipientEmail || !magicUrl) {
      return res.status(400).json({ success: false, error: "Email et URL requis." });
    }

    const magicLink = await prisma.lienMagique.findUnique({
      where: { id },
      include: { dossier: { include: { client: true } } },
    });
    if (!magicLink) {
      return res.status(404).json({ success: false, error: "Lien introuvable." });
    }

    const isLivraison = magicLink.type === "LIVRAISON";
    const dossierRef = magicLink.dossier?.reference || "votre dossier";
    const expiresAt = new Date(magicLink.expiresAt).toLocaleDateString("fr-FR");

    const subject = isLivraison
      ? `Menua Consulting – Documents mis à votre disposition (Réf. ${dossierRef})`
      : `Menua Consulting – Demande de documents (Réf. ${dossierRef})`;

    const actionLabel = isLivraison
      ? "Accéder à mes documents"
      : "Déposer mes documents";

    const bodyText = isLivraison
      ? `Bonjour,\n\nMenua Consulting met à votre disposition des documents dans le cadre de votre dossier (Réf. ${dossierRef}).\n\nVeuillez cliquer sur le lien ci-dessous pour y accéder :\n${magicUrl}\n\nCe lien est valable jusqu'au ${expiresAt}.\n\nCordialement,\nMenua Consulting`
      : `Bonjour,\n\nMenua Consulting vous invite à déposer des documents dans le cadre de votre dossier (Réf. ${dossierRef}).\n\nVeuillez cliquer sur le lien ci-dessous pour effectuer votre dépôt :\n${magicUrl}\n\nCe lien est valable jusqu'au ${expiresAt}.${magicLink.note ? "\n\nMessage de votre conseiller :\n" + magicLink.note : ""}\n\nCordialement,\nMenua Consulting`;

    const bodyHtml = `
<!DOCTYPE html><html><head><meta charset="utf-8"></head>
<body style="font-family:Arial,sans-serif;background:#f4f4f4;margin:0;padding:0">
  <table width="100%" cellpadding="0" cellspacing="0"><tr><td align="center" style="padding:40px 20px">
    <table width="600" cellpadding="0" cellspacing="0" style="background:#fff;border-radius:8px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,0.08)">
      <tr><td style="background:#141824;padding:28px 40px;text-align:center">
        <span style="color:#fff;font-size:22px;font-weight:700;letter-spacing:1px">Menua Consulting</span>
      </td></tr>
      <tr><td style="padding:36px 40px">
        <p style="color:#141824;font-size:16px;margin:0 0 16px">Bonjour,</p>
        <p style="color:#555;font-size:15px;line-height:1.6;margin:0 0 24px">
          ${isLivraison
            ? `Menua Consulting met à votre disposition des documents dans le cadre de votre dossier <strong>(Réf. ${dossierRef})</strong>.`
            : `Menua Consulting vous invite à déposer des documents dans le cadre de votre dossier <strong>(Réf. ${dossierRef})</strong>.`
          }
        </p>
        ${magicLink.note ? `<div style="background:#f8fafc;border-left:4px solid #141824;padding:14px 18px;margin:0 0 24px;border-radius:4px"><p style="margin:0;color:#141824;font-size:14px;line-height:1.6">${magicLink.note.replace(/\n/g, "<br>")}</p></div>` : ""}
        <div style="text-align:center;margin:32px 0">
          <a href="${magicUrl}" style="background:#141824;color:#fff;padding:14px 32px;border-radius:6px;text-decoration:none;font-weight:600;font-size:15px;display:inline-block">${actionLabel}</a>
        </div>
        <p style="color:#999;font-size:13px;margin:0">Ce lien est valable jusqu'au <strong>${expiresAt}</strong>. Si vous n'êtes pas à l'origine de cette demande, veuillez ignorer cet e-mail.</p>
      </td></tr>
      <tr><td style="background:#f8fafc;padding:16px 40px;text-align:center">
        <p style="color:#999;font-size:12px;margin:0">© Menua Consulting · contact@menuaconsulting.com</p>
      </td></tr>
    </table>
  </td></tr></table>
</body></html>`;

    await transporter.sendMail({
      from: `"Menua Consulting" <${process.env.SMTP_USER}>`,
      to: recipientEmail,
      subject,
      text: bodyText,
      html: bodyHtml,
    });

    await logAudit(
      req.user.id,
      "ENVOI_EMAIL_LIEN_MAGIQUE",
      magicLink.id,
      "MAGIC_LINK",
      `Lien magique (${magicLink.type}) envoyé par email à ${recipientEmail}`,
      magicLink.dossierId,
    );

    res.json({ success: true, message: "Email envoyé avec succès." });
  } catch (error) {
    console.error("Erreur envoi email lien magique:", error);
    res.status(500).json({ success: false, error: "Erreur lors de l'envoi de l'email." });
  }
});

// Upload files via Magic Link (ACQUISITION)
router.post("/upload/:token", upload.array("files", 10), async (req, res) => {
  try {
    const { token } = req.params;
    const magicLink = await prisma.lienMagique.findUnique({ where: { token } });

    if (!magicLink)
      return res.status(404).json({ success: false, error: "Lien invalide." });
    if (new Date() > new Date(magicLink.expiresAt))
      return res.status(403).json({ success: false, error: "Lien expiré." });
    if (magicLink.type !== "ACQUISITION")
      return res
        .status(403)
        .json({
          success: false,
          error: "Ce lien ne permet pas le dépôt de fichiers.",
        });

    if (!req.files || req.files.length === 0) {
      return res
        .status(400)
        .json({ success: false, error: "Aucun fichier fourni." });
    }

    const uploadedDocs = [];

    for (const file of req.files) {
      const safeName = file.originalname.replace(/[^a-zA-Z0-9.-]/g, "_");
      const s3Key = `dossiers/${magicLink.dossierId}/${randomUUID()}-${safeName}`;

      // Upload to S3
      await uploadToS3(file.buffer, s3Key, file.mimetype);

      // Create Document in DB
      const doc = await prisma.document.create({
        data: {
          dossierId: magicLink.dossierId,
          name: file.originalname,
          url: s3Key,
          uploadedById: magicLink.createdBy,
        },
      });
      uploadedDocs.push(doc);
    }

    if (uploadedDocs.length > 0) {
      await logAudit(
        magicLink.createdBy,
        "DEPOT_DOCUMENT_MAGIQUE",
        uploadedDocs[0].id,
        "DOCUMENT",
        `${uploadedDocs.length} document(s) déposé(s) via Lien Magique (${uploadedDocs.map((d) => d.name).join(", ")})`,
        magicLink.dossierId,
      );

      // ── Notification Super-Admin & Traitant ──
      try {
        const superAdmins = await prisma.utilisateur.findMany({
          where: { role: { name: "Super-administrateur" } },
          select: { id: true },
        });
        const dossier = await prisma.dossier.findUnique({
          where: { id: magicLink.dossierId },
          select: { traitantId: true },
        });

        const notifyIds = new Set();
        superAdmins.forEach((sa) => notifyIds.add(sa.id));
        if (dossier && dossier.traitantId) notifyIds.add(dossier.traitantId);

        if (notifyIds.size > 0) {
          await notify(Array.from(notifyIds), {
            type: "DOCUMENT_AJOUTE",
            title: "Nouveau dépôt client",
            message: `Le client a déposé ${uploadedDocs.length} document(s) via son lien sécurisé.`,
            targetId: magicLink.dossierId,
            targetType: "DOSSIER",
          });
        }
      } catch (notifErr) {
        console.error("Erreur notification dépôt magique:", notifErr);
      }
    }

    res.json({
      success: true,
      message: `${uploadedDocs.length} fichier(s) uploadé(s) avec succès.`,
      count: uploadedDocs.length,
    });
  } catch (error) {
    console.error("Erreur upload via lien magique:", error);
    res
      .status(500)
      .json({ success: false, error: "Erreur lors du transfert de fichiers." });
  }
});

module.exports = router;
</file>

<file path="apps/admin/src/pages/RolesPage.jsx">
import { getSafeApiUrl } from "../utils/helpers";
import React, { useState, useEffect, useRef } from "react";
import { useTranslation } from "react-i18next";
import { MoreVertical, Pencil, Eye, Trash, Check, AlertTriangle } from "lucide-react";
import ActionDropdown from "../components/ActionDropdown";
import { getStatusBadge } from "../utils/helpers";

const getRoleInitials = (name) => {
  if (!name) return "RO";
  const cleaned = name.replace(/[-_]/g, " ").trim();
  const parts = cleaned.split(/\s+/).filter(Boolean);
  if (parts.length === 1) return parts[0].substring(0, 2).toUpperCase();
  return (parts[0][0] + parts[1][0]).toUpperCase();
};

const RolesPage = () => {
  const { t } = useTranslation();
  const [roles, setRoles] = useState([]);
  const [openMenuId, setOpenMenuId] = useState(null);
  const [showRoleModal, setShowRoleModal] = useState(false);
  const [permissionsOpen, setPermissionsOpen] = useState(false);
  const [editRole, setEditRole] = useState(null);
  const [consultRole, setConsultRole] = useState(null);
  const menuRef = useRef(null);
  const dropdownRef = useRef(null);
  const [selectedPermissions, setSelectedPermissions] = useState([]);
  const [newRole, setNewRole] = useState({
    name: "",
    description: "",
    status: "Actif",
  });
  const [deleteRole, setDeleteRole] = useState(null);
  const isTableViewHidden = showRoleModal || editRole || consultRole;

  const availablePermissions = [
    { value: "MESSAGES_VIEW", label: "Consulter les messages" },
    { value: "MESSAGES_PROCESS", label: "Traiter les messages" },
    { value: "DOSSIERS_MANAGE", label: "Gérer les dossiers" },
    { value: "TACHES_MANAGE", label: "Créer et gérer les tâches" },
    { value: "TACHES_VIEW_ALL", label: "Consulter toutes les tâches" },
    { value: "TACHES_VALIDATE", label: "Valider les tâches" },
    { value: "TACHES_VIEW_ASSIGNED", label: "Voir ses tâches assignées" },
    { value: "TACHES_EDIT_ASSIGNED", label: "Modifier ses tâches assignées" },
    { value: "CLIENTS_MANAGE", label: "Gérer les clients" },
    { value: "USERS_MANAGE", label: "Gérer les utilisateurs" },
    { value: "ROLES_MANAGE", label: "Gérer les rôles" },
  ];

  const getPermLabel = (val) =>
    availablePermissions.find((p) => p.value === val)?.label || val;

  const togglePerm = (perm) => {
    setSelectedPermissions((prev) =>
      prev.includes(perm) ? prev.filter((p) => p !== perm) : [...prev, perm],
    );
  };

  const fetchData = async () => {
    try {
      const token = sessionStorage.getItem("adminToken");
      if (!token) return;

      const [rUsers, rRoles] = await Promise.all([
        fetch(new URL(getSafeApiUrl(`/api/crm/users`)).toString(), {
          headers: { Authorization: `Bearer ${token}` },
        })
          .then((r) => r.json())
          .catch(() => []),
        fetch(new URL(getSafeApiUrl(`/api/crm/roles`)).toString(), {
          headers: { Authorization: `Bearer ${token}` },
        })
          .then((r) => r.json())
          .catch(() => []),
      ]);

      const validRoles = Array.isArray(rRoles) ? rRoles : [];
      const validUsers = Array.isArray(rUsers) ? rUsers : [];

      const roleCounts = validUsers.reduce((acc, user) => {
        if (user.roleId) acc[user.roleId] = (acc[user.roleId] || 0) + 1;
        return acc;
      }, {});

      setRoles(
        validRoles.map((r) => ({
          ...r,
          users: roleCounts[r.id] || 0,
        })),
      );
    } catch (error) {
      console.error("Erreur fetchData roles:", error);
    }
  };

  useEffect(() => {
    fetchData();

    const handleClickOutside = (event) => {
      if (
        menuRef.current &&
        !menuRef.current.contains(event.target) &&
        !event.target.closest(".action-menu-trigger")
      ) {
        setOpenMenuId(null);
      }
      if (dropdownRef.current && !dropdownRef.current.contains(event.target)) {
        setPermissionsOpen(false);
      }
    };
    document.addEventListener("mousedown", handleClickOutside);
    return () => document.removeEventListener("mousedown", handleClickOutside);
  }, []);

  const toggleMenu = (e, id) => {
    e.preventDefault();
    e.stopPropagation();
    setOpenMenuId((prev) => (prev === id ? null : id));
  };

  const handleDeleteRole = async () => {
    if (!deleteRole) return;
    try {
      await fetch(
        getSafeApiUrl(`/api/crm/roles/${encodeURIComponent(deleteRole.id)}`),
        {
          method: "DELETE",
          headers: {
            Authorization: "Bearer " + sessionStorage.getItem("adminToken"),
          },
        },
      );
      fetchData();
      if (editRole && editRole.id === deleteRole.id) setEditRole(null);
    } catch (e) {
      console.error("Erreur lors de la suppression:", e);
    }
    setDeleteRole(null);
  };

  const renderDropdown = (role) => {
    return (
      <ActionDropdown
        isOpen={openMenuId === role.id}
        menuRef={menuRef}
        width="150px"
      >
        <button
          type="button"
          className="dropdown-item"
          onClick={() => {
            setConsultRole(role);
            setOpenMenuId(null);
          }}
        >
          <Eye size={14} /> {t("common.view", "Consulter")}
        </button>
        <button
          type="button"
          className="dropdown-item"
          onClick={() => {
            setEditRole({ ...role });
            try {
              setSelectedPermissions(JSON.parse(role.permissions || "[]"));
            } catch (e) {
              setSelectedPermissions([]);
            }
            setOpenMenuId(null);
          }}
        >
          <Pencil size={14} /> {t("common.edit", "Modifier")}
        </button>
        <button
          type="button"
          className="dropdown-item danger"
          onClick={() => {
            setDeleteRole(role);
            setOpenMenuId(null);
          }}
        >
          <Trash size={14} /> {t("common.delete", "Supprimer")}
        </button>
      </ActionDropdown>
    );
  };

  const renderRoleForm = (title, roleData, setRoleData, onSubmit, onCancel) => (
    <div className="fade-in" style={{ padding: "1rem" }}>
      <div className="" style={{ width: "100%", position: "relative" }}>
        <div
          style={{
            display: "flex",
            alignItems: "center",
            gap: "1rem",
            marginBottom: "2rem",
            borderBottom: "1px solid var(--border)",
            paddingBottom: "1.5rem",
          }}
        >
          <button
            type="button"
            onClick={onCancel}
            className="btn btn-outline"
            style={{ padding: "0.5rem 1rem", color: "var(--text-main)" }}
          >
            {t("common.back", "← Retour")}
          </button>
          <h2 style={{ margin: 0, fontSize: "1.5rem", fontWeight: 600 }}>
            {title}
          </h2>
        </div>

        <form style={{ display: "flex", flexDirection: "column", gap: "1rem" }}>
          <div>
            <label
              style={{
                display: "block",
                marginBottom: "0.25rem",
                
                fontWeight: 500,
              }}
            >
              Intitulé du rôle
            </label>
            <input
              type="text"
              value={roleData.name || ""}
              onChange={(e) =>
                setRoleData({ ...roleData, name: e.target.value })
              }
              placeholder="Ex: GESTIONNAIRE"
              style={{
                width: "100%",
                padding: "0.5rem",
                borderRadius: "4px",
                border: "1px solid var(--border)",
              }}
            />
          </div>
          <div>
            <label
              style={{
                display: "block",
                marginBottom: "0.25rem",
                
                fontWeight: 500,
              }}
            >
              Permissions
            </label>
            <div style={{ position: "relative" }} ref={dropdownRef}>
              <button
                type="button"
                onClick={() => setPermissionsOpen(!permissionsOpen)}
                style={{
                  width: "100%",
                  padding: "0.5rem",
                  minHeight: "38px",
                  borderRadius: "4px",
                  border: "1px solid var(--border)",
                  background: "white",
                  cursor: "pointer",
                  display: "flex",
                  justifyContent: "space-between",
                  alignItems: "center",
                  fontFamily: "inherit",
                  fontSize: "inherit",
                }}
              >
                <span
                  style={{
                    color:
                      selectedPermissions.length > 0
                        ? "var(--text-main)"
                        : "var(--text-muted)",
                  }}
                >
                  {selectedPermissions.length > 0
                    ? selectedPermissions.map(getPermLabel).join(", ")
                    : "Sélectionner des permissions..."}
                </span>
                <span
                  style={{
                    fontSize: "0.75rem",
                    color: "var(--text-muted)",
                    flexShrink: 0,
                    marginLeft: "0.5rem",
                  }}
                >
                  ▼
                </span>
              </button>
              {permissionsOpen && (
                <div
                  style={{
                    position: "absolute",
                    top: "100%",
                    left: 0,
                    right: 0,
                    marginTop: "4px",
                    background: "white",
                    border: "1px solid var(--border)",
                    borderRadius: "4px",
                    boxShadow: "0 4px 6px rgba(0,0,0,0.1)",
                    zIndex: 10,
                    maxHeight: "200px",
                    overflowY: "auto",
                    padding: "0.5rem",
                    display: "flex",
                    flexDirection: "column",
                    gap: "0.5rem",
                  }}
                >
                  {availablePermissions.map((p) => (
                    <label
                      key={p.value}
                      style={{
                        display: "flex",
                        alignItems: "center",
                        gap: "0.5rem",
                        cursor: "pointer",
                        
                      }}
                    >
                      <input
                        type="checkbox"
                        checked={selectedPermissions.includes(p.value)}
                        onChange={() => togglePerm(p.value)}
                      />{" "}
                      {p.label}
                    </label>
                  ))}
                </div>
              )}
            </div>
          </div>
          <div>
            <label
              style={{
                display: "block",
                marginBottom: "0.25rem",
                
                fontWeight: 500,
              }}
            >
              Description du rôle
            </label>
            <textarea
              rows="3"
              value={roleData.description || ""}
              onChange={(e) =>
                setRoleData({ ...roleData, description: e.target.value })
              }
              placeholder="Description des responsabilités..."
              style={{
                width: "100%",
                padding: "0.5rem",
                borderRadius: "4px",
                border: "1px solid var(--border)",
                resize: "vertical",
                fontFamily: "inherit",
              }}
            ></textarea>
          </div>
          <div>
            <label
              style={{
                display: "block",
                marginBottom: "0.25rem",
                
                fontWeight: 500,
              }}
            >
              Statut
            </label>
            <select
              value={roleData.status || "Actif"}
              onChange={(e) =>
                setRoleData({ ...roleData, status: e.target.value })
              }
              style={{
                width: "100%",
                padding: "0.5rem",
                borderRadius: "4px",
                border: "1px solid var(--border)",
                background: "white",
              }}
            >
              <option value="Actif">Actif</option>
              <option value="Inactif">Inactif</option>
            </select>
          </div>
          <div
            style={{
              display: "flex",
              justifyContent: "flex-end",
              gap: "0.5rem",
              marginTop: "1rem",
            }}
          >
            <button
              type="button"
              onClick={onCancel}
              className="btn btn-outline"
            >
              Annuler
            </button>
            <button
              type="submit"
              className="btn btn-primary"
              onClick={onSubmit}
            >
              {title.includes("Créer") ? "Créer le rôle" : "Sauvegarder"}
            </button>
          </div>
        </form>
      </div>
    </div>
  );

  return (
    <div style={{ padding: "0 1rem" }}>
      {!isTableViewHidden && (
        <>
          <div
            style={{
              display: "flex",
              justifyContent: "space-between",
              alignItems: "center",
              marginBottom: "1.5rem",
            }}
          >
            <h1
              style={{
                fontSize: "1.5rem",
                fontWeight: 600,
                color: "var(--text-main)",
              }}
            >
              {t("roles.title", "Rôles")}
            </h1>
            <button
              type="button"
              onClick={() => setShowRoleModal(true)}
              className="btn btn-primary"
              style={{
                display: "flex",
                gap: "0.5rem",
                alignItems: "center",
                height: "28px",
                padding: "0 0.75rem",
                
              }}
            >
              {t("roles.createRole", "Créer un rôle")}
            </button>
          </div>

          <div className="card" style={{ padding: 0, overflow: "visible" }}>
            <div className="table-wrapper">
              <table style={{ tableLayout: "fixed", width: "100%" }}>
                <thead>
                  <tr>
                    <th style={{ width: "20%", textAlign: "left", paddingLeft: "1.25rem" }}>N°</th>
                    <th style={{ width: "20%" }}>Intitulé</th>
                    <th style={{ width: "20%" }}>Date de création</th>
                    <th style={{ width: "30%" }}>Statut</th>
                    <th style={{ width: "10%" }}>{t("common.actions", "Actions")}</th>
                  </tr>
                </thead>
                <tbody>
                  {roles.map((r) => (
                    <tr key={r.id}>
                      <td style={{ textAlign: "left", paddingLeft: "1.25rem", color: "var(--text-muted)", fontSize: "0.85rem" }}>
                        <div className="truncate-name" style={{ maxWidth: "100%" }} title={r.id}>
                          {r.id.split('-')[0]}...
                        </div>
                      </td>
                      <td>
                        <div className="truncate-name" style={{ maxWidth: "100%", fontWeight: 500 }} title={r.name}>
                          {r.name}
                        </div>
                      </td>
                      <td>
                        <span style={{ color: "var(--text-muted)" }}>
                          {new Date(r.createdAt || Date.now()).toLocaleDateString("fr-FR")}
                        </span>
                      </td>
                      <td>
                        <span
                          style={{
                            color: r.status === "Inactif" ? "var(--danger)" : "var(--success)",
                          }}
                        >
                          {r.status === "Inactif" ? t("common.inactive", "Inactif") : t("common.active", "Actif")}
                        </span>
                      </td>
                      <td style={{ overflow: "visible", position: "relative", zIndex: openMenuId === r.id ? 1000 : 1 }}>
                        <div
                          style={{
                            display: "flex",
                            gap: "0.5rem",
                            justifyContent: "center",
                          }}
                        >
                          <div style={{ position: "relative" }}>
                            <button
                              type="button"
                              className="action-menu-trigger"
                              onClick={(e) => toggleMenu(e, r.id)}
                              style={{
                                background: openMenuId === r.id ? "#E2E8F0" : "transparent",
                                border: "1px solid #E2E8F0",
                                borderRadius: "8px",
                                width: "32px",
                                height: "32px",
                                display: "inline-flex",
                                alignItems: "center",
                                justifyContent: "center",
                                cursor: "pointer",
                                color: "#4A5568",
                              }}
                              title="Options"
                            >
                              <MoreVertical size={16} />
                            </button>
                            {renderDropdown(r)}
                          </div>
                        </div>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </>
      )}

      {/* Modal Créer un Rôle */}
      {showRoleModal &&
        renderRoleForm(
          "Créer un Rôle",
          newRole,
          setNewRole,
          async (e) => {
            e.preventDefault();
            try {
              const res = await fetch(getSafeApiUrl("/api/crm/roles"), {
                method: "POST",
                headers: {
                  "Content-Type": "application/json",
                  Authorization:
                    "Bearer " + sessionStorage.getItem("adminToken"),
                },
                body: JSON.stringify({
                  name: newRole.name,
                  description: newRole.description,
                  status: newRole.status,
                  permissions: JSON.stringify(selectedPermissions),
                }),
              });
              const data = await res.json();
              if (!res.ok) {
                alert("Erreur: " + (data.error || "Impossible de créer le rôle"));
                return;
              }
              setNewRole({ name: "", description: "", status: "Actif" });
              setSelectedPermissions([]);
              setShowRoleModal(false);
              fetchData();
            } catch (err) {
              console.error("Erreur lors de la création:", err);
              alert("Erreur réseau");
            }
          },
          () => setShowRoleModal(false),
        )}

      {/* Modal Modifier un Rôle */}
      {editRole && (() => {
